{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flossware.dev/claude-ensemble/schemas/knowledge.schema.json",
  "title": "Claude Ensemble knowledge Contract Schema",
  "description": "Normative JSON request/response schemas. HTTP headers, status codes, deadlines, idempotency, and lifecycle invariants are specified in the linked service contract.",
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "visibility"
      ],
      "properties": {
        "type": {
          "enum": [
            "user",
            "project",
            "shared",
            "global"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "visibility": {
          "enum": [
            "private",
            "shared",
            "global"
          ]
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "origin": {
          "type": "string",
          "maxLength": 2048
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_uri": {
          "type": "string",
          "maxLength": 4096
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "verificationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "revision_sequence"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 10,
          "maxLength": 138,
          "pattern": "^knowledge:[A-Za-z0-9._~-]{1,128}$"
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "verificationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "request_id"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/verificationItem"
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "verificationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "results",
        "request_id"
      ],
      "properties": {
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "requested_revision_sequence",
              "status"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 10,
                "maxLength": 138,
                "pattern": "^knowledge:[A-Za-z0-9._~-]{1,128}$"
              },
              "requested_revision_sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "status": {
                "enum": [
                  "current",
                  "stale",
                  "tombstoned",
                  "not_found"
                ]
              },
              "canonical_revision_sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "request_id"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "createRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "source_kind",
        "content",
        "provenance",
        "retention_policy",
        "index_profile"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "source_kind": {
          "enum": [
            "document",
            "file",
            "note",
            "url",
            "record",
            "code",
            "other"
          ]
        },
        "canonical_locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "index_profile": {
          "$ref": "#/$defs/profile"
        },
        "retention_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "standard",
                "ephemeral",
                "retained"
              ]
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "updateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_base_revision_sequence",
        "content",
        "provenance",
        "index_profile"
      ],
      "properties": {
        "expected_base_revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "index_profile": {
          "$ref": "#/$defs/profile"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "deleteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "delete_scope"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "delete_scope": {
          "const": "source"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "mutationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "source_id",
        "revision",
        "revision_sequence",
        "status",
        "request_id",
        "indexing_status",
        "index_profile"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 14,
          "maxLength": 256,
          "pattern": "^knowledge:op:.+"
        },
        "source_id": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1024,
          "pattern": "^knowledge:.+"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "accepted",
            "pending",
            "complete",
            "failed",
            "reconciliation_required"
          ]
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "indexing_status": {
          "enum": [
            "pending_index",
            "indexed",
            "index_failed",
            "reconciliation_required"
          ]
        },
        "index_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "digest"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            }
          }
        }
      }
    },
    "sourceId": {
      "type": "string",
      "minLength": 10,
      "maxLength": 138,
      "pattern": "^knowledge:[A-Za-z0-9._~-]{1,128}$"
    },
    "fenceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_generation",
        "snapshot_id"
      ],
      "properties": {
        "target_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "fenceResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "target_generation",
        "fence_token",
        "expires_at",
        "request_id",
        "fence_id",
        "sealed_change_sequence",
        "fence_state"
      ],
      "properties": {
        "owner": {
          "const": "knowledge"
        },
        "target_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "fence_token": {
          "type": "string",
          "minLength": 16,
          "maxLength": 512
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "fence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sealed_change_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fence_state": {
          "const": "held"
        }
      }
    },
    "fenceReleaseRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_generation",
        "fence_token"
      ],
      "properties": {
        "target_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "fence_token": {
          "type": "string",
          "minLength": 16,
          "maxLength": 512
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "fenceReleaseResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "target_generation",
        "released",
        "request_id",
        "fence_id"
      ],
      "properties": {
        "owner": {
          "const": "knowledge"
        },
        "target_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "released": {
          "type": "boolean"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "fence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "operationStatusResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "status",
        "canonical_status",
        "indexing_status",
        "request_id"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^knowledge:op:.+",
          "minLength": 14,
          "maxLength": 256
        },
        "status": {
          "enum": [
            "accepted",
            "pending",
            "complete",
            "failed",
            "reconciliation_required"
          ]
        },
        "canonical_status": {
          "enum": [
            "committed",
            "tombstoned"
          ]
        },
        "indexing_status": {
          "enum": [
            "pending_index",
            "indexed",
            "index_failed",
            "reconciliation_required"
          ]
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "canonicalReadResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_revision",
        "revision_sequence",
        "scope",
        "source_kind",
        "content",
        "provenance",
        "retention_policy",
        "index_profile",
        "status",
        "request_id"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 10,
          "maxLength": 138,
          "pattern": "^knowledge:[A-Za-z0-9._~-]{1,128}$"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "source_kind": {
          "enum": [
            "document",
            "file",
            "note",
            "url",
            "record",
            "code",
            "other"
          ]
        },
        "canonical_locator": {
          "type": "string",
          "maxLength": 4096
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "retention_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "standard",
                "ephemeral",
                "retained"
              ]
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "index_profile": {
          "$ref": "#/$defs/profile"
        },
        "status": {
          "enum": [
            "active",
            "tombstoned"
          ]
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "manifestRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limit",
        "request_id"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "maxLength": 256
        },
        "cursor": {
          "type": "string",
          "maxLength": 512
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "manifestResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "items",
        "next_cursor",
        "request_id"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "revision_sequence",
              "status"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 10,
                "maxLength": 138,
                "pattern": "^knowledge:[A-Za-z0-9._~-]{1,128}$"
              },
              "source_revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "revision_sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "status": {
                "enum": [
                  "active",
                  "tombstoned"
                ]
              },
              "index_profile": {
                "$ref": "#/$defs/profile"
              }
            }
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "reconciliationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_generation",
        "index_profile",
        "request_id"
      ],
      "properties": {
        "target_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "snapshot_id": {
          "type": "string",
          "maxLength": 256
        },
        "index_profile": {
          "$ref": "#/$defs/profile"
        },
        "exclusion_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allow_exclusions"
          ],
          "properties": {
            "allow_exclusions": {
              "type": "boolean"
            },
            "reason_code": {
              "type": "string",
              "maxLength": 128
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "reconciliationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "target_generation",
        "status",
        "request_id"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^knowledge:op:[A-Za-z0-9._~-]{1,128}$",
          "minLength": 14,
          "maxLength": 141
        },
        "target_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "enum": [
            "accepted",
            "pending",
            "complete",
            "failed",
            "reconciliation_required"
          ]
        },
        "applied_change_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "safe_error_code": {
          "type": "string",
          "maxLength": 128
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "x-request-oneOf": [
    {
      "$ref": "#/$defs/createRequest"
    },
    {
      "$ref": "#/$defs/updateRequest"
    },
    {
      "$ref": "#/$defs/deleteRequest"
    },
    {
      "$ref": "#/$defs/verificationRequest"
    }
  ],
  "x-response-oneOf": [
    {
      "$ref": "#/$defs/mutationResponse"
    },
    {
      "$ref": "#/$defs/verificationResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ],
  "oneOf": [
    {
      "$ref": "#/$defs/createRequest"
    },
    {
      "$ref": "#/$defs/updateRequest"
    },
    {
      "$ref": "#/$defs/deleteRequest"
    },
    {
      "$ref": "#/$defs/verificationRequest"
    },
    {
      "$ref": "#/$defs/mutationResponse"
    },
    {
      "$ref": "#/$defs/verificationResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    },
    {
      "$ref": "#/$defs/fenceRequest"
    },
    {
      "$ref": "#/$defs/fenceReleaseRequest"
    },
    {
      "$ref": "#/$defs/fenceResponse"
    },
    {
      "$ref": "#/$defs/fenceReleaseResponse"
    },
    {
      "$ref": "#/$defs/operationStatusResponse"
    },
    {
      "$ref": "#/$defs/canonicalReadResponse"
    },
    {
      "$ref": "#/$defs/manifestRequest"
    },
    {
      "$ref": "#/$defs/manifestResponse"
    },
    {
      "$ref": "#/$defs/reconciliationRequest"
    },
    {
      "$ref": "#/$defs/reconciliationResponse"
    }
  ],
  "x-endpoints": {
    "POST /api/v1/knowledge/sources": {
      "request": "$defs/createRequest",
      "response": "$defs/mutationResponse",
      "success_status": 202
    },
    "DELETE /api/v1/knowledge/sources/{source_key}": {
      "request": "$defs/deleteRequest",
      "response": "$defs/mutationResponse",
      "success_status": 202
    },
    "POST /api/v1/knowledge/sources/verify-revisions": {
      "request": "$defs/verificationRequest",
      "response": "$defs/verificationResponse",
      "success_status": 200
    },
    "GET /api/v1/knowledge/operations/{operation_id}": {
      "response": "$defs/operationStatusResponse",
      "success_status": 200
    },
    "GET /api/v1/knowledge/sources/{source_key}": {
      "response": "$defs/canonicalReadResponse",
      "success_status": 200
    },
    "GET /api/v1/knowledge/reconciliation/manifest": {
      "request": "$defs/manifestRequest",
      "response": "$defs/manifestResponse",
      "success_status": 200
    },
    "POST /api/v1/knowledge/reconciliation": {
      "request": "$defs/reconciliationRequest",
      "response": "$defs/reconciliationResponse",
      "success_status": 202
    },
    "POST /api/v1/knowledge/sources/{source_key}/revisions": {
      "request": "$defs/updateRequest",
      "response": "$defs/mutationResponse",
      "success_status": 202
    },
    "GET /api/v1/knowledge/sources/{source_key}/operations/{operation_id}": {
      "response": "$defs/operationStatusResponse",
      "success_status": 200
    }
  }
}
