{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flossware.dev/claude-ensemble/schemas/ranking.schema.json",
  "title": "Claude Ensemble Ranking request and response",
  "$defs": {
    "chunker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "version"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_revision",
        "revision_sequence",
        "chunk_id",
        "chunker",
        "retrieval_source",
        "list_id",
        "retrieval_rank",
        "text"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^(memory|knowledge):[A-Za-z0-9_-]+$",
          "maxLength": 1024
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "chunk_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "chunker": {
          "$ref": "#/$defs/chunker"
        },
        "retrieval_source": {
          "enum": [
            "lexical",
            "vector",
            "graph",
            "memory",
            "knowledge"
          ]
        },
        "list_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "retrieval_rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "source_score": {
          "type": "number"
        },
        "score_semantics": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "maxLength": 65536
        },
        "matched_exact_identifiers": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "provenance": {
          "type": "object",
          "maxProperties": 100
        },
        "evidence": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "maxProperties": 20
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "policy",
        "exact_identifiers",
        "candidates",
        "limit"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "const": "rrf"
            },
            "version": {
              "const": "rrf-v1"
            }
          }
        },
        "exact_identifiers": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "candidates": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "rankedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_revision",
        "revision_sequence",
        "chunk_id",
        "chunker",
        "rank",
        "fusion_score",
        "score_semantics",
        "evidence"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^(memory|knowledge):[A-Za-z0-9_-]+$",
          "maxLength": 1024
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "chunk_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "chunker": {
          "$ref": "#/$defs/chunker"
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "fusion_score": {
          "type": "integer",
          "minimum": 0
        },
        "score_semantics": {
          "const": "rrf-fixed-1e12"
        },
        "matched_exact_identifiers": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "maxProperties": 20
          }
        },
        "provenance": {
          "type": "object",
          "maxProperties": 100
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "policy",
        "candidates"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "const": "rrf"
            },
            "version": {
              "const": "rrf-v1"
            }
          }
        },
        "candidates": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/rankedCandidate"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ]
}
