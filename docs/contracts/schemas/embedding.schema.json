{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flossware.dev/claude-ensemble/schemas/embedding.schema.json",
  "title": "Embedding REST Contract Schema",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index_profile",
        "profile",
        "profile_version",
        "inputs"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "index_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "digest"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            }
          }
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "profile_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input_id",
              "input_type",
              "text"
            ],
            "properties": {
              "input_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "input_type": {
                "enum": [
                  "query",
                  "document"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              }
            }
          }
        },
        "normalize": {
          "enum": [
            "profile-default",
            "none",
            "l2"
          ]
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index_profile",
        "profile",
        "profile_version",
        "model",
        "results",
        "request_id"
      ],
      "properties": {
        "index_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "digest"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            }
          }
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "profile_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "model_id",
            "model_version",
            "dimensions",
            "normalization"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "model_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "model_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "dimensions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "normalization": {
              "enum": [
                "none",
                "l2"
              ]
            }
          }
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input_id",
              "input_type",
              "status"
            ],
            "properties": {
              "input_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "input_type": {
                "enum": [
                  "query",
                  "document"
                ]
              },
              "status": {
                "enum": [
                  "complete",
                  "failed"
                ]
              },
              "vector": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4096,
                "items": {
                  "type": "number"
                }
              },
              "dimensions": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "error_code": {
                "type": "string",
                "maxLength": 128
              }
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "request_id"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "message": {
              "type": "string",
              "maxLength": 1024
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ],
  "x-endpoints": {
    "POST /api/v1/embeddings": {
      "request": "$defs/request",
      "response": "$defs/response",
      "success_status": 200
    }
  }
}
