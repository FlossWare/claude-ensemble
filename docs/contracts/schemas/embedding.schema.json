{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flossware.dev/claude-ensemble/schemas/embedding.schema.json",
  "title": "Embedding REST Contract Schema",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index_profile",
        "profile",
        "profile_version",
        "inputs"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "index_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "digest"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            }
          }
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "profile_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input_id",
              "input_type",
              "text"
            ],
            "properties": {
              "input_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "input_type": {
                "enum": [
                  "query",
                  "document"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              }
            }
          }
        },
        "normalize": {
          "enum": [
            "profile-default",
            "none",
            "l2"
          ]
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index_profile",
        "profile",
        "profile_version",
        "model",
        "results",
        "request_id"
      ],
      "properties": {
        "index_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "digest"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            }
          }
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "profile_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "model_id",
            "model_version",
            "dimensions",
            "normalization"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "model_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "model_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "dimensions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "normalization": {
              "enum": [
                "none",
                "l2"
              ]
            }
          }
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input_id",
              "input_type",
              "status"
            ],
            "properties": {
              "input_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "input_type": {
                "enum": [
                  "query",
                  "document"
                ]
              },
              "status": {
                "enum": [
                  "complete",
                  "failed"
                ]
              },
              "vector": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4096,
                "items": {
                  "type": "number"
                }
              },
              "dimensions": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "error_code": {
                "type": "string",
                "maxLength": 128
              }
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "request_id"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "enum": [
                "active_generation_cannot_be_abandoned",
                "candidate_identity_conflict",
                "conflict",
                "context_assembly_failed",
                "cutover_in_progress",
                "deadline_exceeded",
                "dependency_unavailable",
                "duplicate_list_id",
                "duplicate_retrieval_rank",
                "endpoint_not_found",
                "fence_expired",
                "fence_released",
                "generation_not_caught_up",
                "generation_not_found",
                "graph_replay_incomplete",
                "idempotency_conflict",
                "idempotency_key_expired",
                "incompatible_representation",
                "internal_error",
                "invalid_candidate",
                "invalid_embedding_mode",
                "invalid_fence",
                "invalid_node",
                "invalid_parameter",
                "invalid_request",
                "invalid_scope",
                "local_access_denied",
                "missing_endpoint_node",
                "not_found",
                "not_ready",
                "operation_failed",
                "operation_not_found",
                "profile_digest_mismatch",
                "profile_invalid",
                "profile_mismatch",
                "profile_not_found",
                "profile_retired",
                "rate_limited",
                "reconciliation_required",
                "request_too_large",
                "revision_conflict",
                "revision_sequence_regression",
                "sequence_regression",
                "service_unavailable",
                "source_revision_mismatch",
                "source_tombstoned",
                "source_too_large",
                "source_unavailable",
                "tokenization_failed",
                "traversal_limit_exceeded",
                "unsupported_media_type",
                "unsupported_policy",
                "unsupported_profile",
                "upstream_failure",
                "vector_dimension_mismatch"
              ]
            },
            "message": {
              "type": "string",
              "maxLength": 1024
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "healthResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "status",
        "request_id"
      ],
      "properties": {
        "service": {
          "const": "embedding"
        },
        "status": {
          "const": "alive"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "readinessResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "status",
        "ready",
        "checks",
        "request_id"
      ],
      "properties": {
        "service": {
          "const": "embedding"
        },
        "status": {
          "enum": [
            "ready",
            "not_ready",
            "degraded"
          ]
        },
        "ready": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "status": {
                "enum": [
                  "ok",
                  "not_ready",
                  "degraded"
                ]
              },
              "code": {
                "type": "string",
                "maxLength": 128
              }
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "x-endpoints": {
    "POST /api/v1/embeddings": {
      "request": "#/$defs/request",
      "response": "#/$defs/response",
      "success_status": 200,
      "error_response": "#/$defs/errorResponse",
      "error_statuses": [
        400,
        404,
        409,
        413,
        422,
        429,
        500,
        503,
        504
      ],
      "x-callers": [
        "memory",
        "knowledge",
        "vector-retrieval"
      ]
    },
    "GET /api/v1/embedding/health": {
      "response": "#/$defs/healthResponse",
      "success_status": 200,
      "error_response": "#/$defs/errorResponse",
      "error_statuses": [
        429,
        500,
        503
      ],
      "x-callers": [
        "health-probe"
      ]
    },
    "GET /api/v1/embedding/ready": {
      "response": "#/$defs/readinessResponse",
      "success_status": 200,
      "error_response": "#/$defs/errorResponse",
      "error_statuses": [
        429,
        500,
        503
      ],
      "x-callers": [
        "health-probe"
      ]
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/healthResponse"
    },
    {
      "$ref": "#/$defs/readinessResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ]
}
