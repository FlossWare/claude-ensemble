{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flossware.dev/claude-ensemble/schemas/vector-retrieval.schema.json",
  "title": "Vector Retrieval REST Contract Schema",
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "visibility"
      ],
      "properties": {
        "type": {
          "enum": [
            "user",
            "project",
            "shared",
            "global"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "visibility": {
          "enum": [
            "private",
            "shared",
            "global"
          ]
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "scope",
        "index_profile",
        "embedding_profile",
        "limit",
        "query",
        "index_generation"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "query_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "index_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "digest"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            }
          }
        },
        "embedding_profile": {
          "$ref": "#/$defs/componentProfile"
        },
        "query": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "vector": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": {
                "type": "number"
              }
            },
            "model": {
              "type": "string",
              "maxLength": 256
            },
            "model_version": {
              "type": "string",
              "maxLength": 128
            },
            "dimensions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "input_type": {
              "const": "query"
            }
          },
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "vector",
                "model",
                "model_version",
                "dimensions",
                "input_type"
              ],
              "properties": {
                "vector": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4096,
                  "items": {
                    "type": "number"
                  }
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "model_version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "dimensions": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                },
                "input_type": {
                  "const": "query"
                }
              }
            }
          ]
        },
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_ids": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 8,
                "maxLength": 138,
                "pattern": "^(memory|knowledge):[A-Za-z0-9._~-]{1,128}$"
              }
            },
            "source_revisions": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "page_token": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "index_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_id",
        "source_id",
        "source_revision",
        "revision_sequence",
        "chunker",
        "text",
        "retrieval_rank",
        "distance",
        "provenance"
      ],
      "properties": {
        "chunk_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "source_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 138,
          "pattern": "^(memory|knowledge):[A-Za-z0-9._~-]{1,128}$"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "chunker": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "version"
          ],
          "properties": {
            "profile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "retrieval_rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "distance": {
          "type": "number"
        },
        "provenance": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": true
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "index_profile",
        "embedding_profile",
        "metric",
        "candidates",
        "truncated",
        "next_page_token",
        "request_id",
        "index_generation"
      ],
      "properties": {
        "query_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "index_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "digest"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            }
          }
        },
        "embedding_profile": {
          "$ref": "#/$defs/componentProfile"
        },
        "metric": {
          "enum": [
            "cosine_distance",
            "cosine_similarity",
            "dot_product",
            "euclidean_distance"
          ]
        },
        "candidates": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "next_page_token": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "index_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "request_id"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "enum": [
                "invalid_request",
                "invalid_parameter",
                "not_found",
                "endpoint_not_found",
                "conflict",
                "idempotency_conflict",
                "idempotency_key_expired",
                "revision_conflict",
                "revision_sequence_regression",
                "generation_not_caught_up",
                "generation_not_found",
                "profile_not_found",
                "profile_retired",
                "profile_invalid",
                "profile_digest_mismatch",
                "profile_mismatch",
                "unsupported_profile",
                "unsupported_policy",
                "incompatible_representation",
                "source_too_large",
                "request_too_large",
                "source_unavailable",
                "source_tombstoned",
                "source_revision_mismatch",
                "duplicate_list_id",
                "duplicate_retrieval_rank",
                "candidate_identity_conflict",
                "invalid_candidate",
                "invalid_node",
                "missing_endpoint_node",
                "traversal_limit_exceeded",
                "invalid_embedding_mode",
                "vector_dimension_mismatch",
                "tokenization_failed",
                "invalid_scope",
                "local_access_denied",
                "not_ready",
                "cutover_in_progress",
                "fence_expired",
                "fence_released",
                "invalid_fence",
                "operation_not_found",
                "dependency_unavailable",
                "service_unavailable",
                "rate_limited",
                "unsupported_media_type",
                "upstream_failure",
                "deadline_exceeded",
                "context_assembly_failed",
                "internal_error",
                "reconciliation_required",
                "operation_failed",
                "sequence_regression"
              ]
            },
            "message": {
              "type": "string",
              "maxLength": 1024
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "componentProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "healthResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "status",
        "request_id"
      ],
      "properties": {
        "service": {
          "const": "vector-retrieval"
        },
        "status": {
          "const": "alive"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "readinessResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "status",
        "ready",
        "checks",
        "request_id"
      ],
      "properties": {
        "service": {
          "const": "vector-retrieval"
        },
        "status": {
          "enum": [
            "ready",
            "not_ready",
            "degraded"
          ]
        },
        "ready": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "status": {
                "enum": [
                  "ok",
                  "not_ready",
                  "degraded"
                ]
              },
              "code": {
                "type": "string",
                "maxLength": 128
              }
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "x-endpoints": {
    "POST /api/v1/vector-retrieval/search": {
      "request": "#/$defs/request",
      "response": "#/$defs/response",
      "success_status": 200,
      "error_response": "#/$defs/errorResponse",
      "error_statuses": [
        400,
        404,
        409,
        413,
        422,
        429,
        500,
        503,
        504
      ]
    },
    "GET /api/v1/vector-retrieval/health": {
      "response": "#/$defs/healthResponse",
      "success_status": 200,
      "error_response": "#/$defs/errorResponse",
      "error_statuses": [
        429,
        500,
        503
      ]
    },
    "GET /api/v1/vector-retrieval/ready": {
      "response": "#/$defs/readinessResponse",
      "success_status": 200,
      "error_response": "#/$defs/errorResponse",
      "error_statuses": [
        429,
        500,
        503
      ]
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/healthResponse"
    },
    {
      "$ref": "#/$defs/readinessResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ]
}
