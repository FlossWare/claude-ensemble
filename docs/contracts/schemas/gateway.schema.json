{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flossware.dev/claude-ensemble/schemas/gateway.schema.json",
  "title": "Claude Ensemble gateway Contract Schema",
  "description": "Normative JSON request/response schemas. HTTP headers, status codes, deadlines, idempotency, and lifecycle invariants are specified in the linked service contract.",
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "visibility"
      ],
      "properties": {
        "type": {
          "enum": [
            "user",
            "project",
            "shared",
            "global"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "visibility": {
          "enum": [
            "private",
            "shared",
            "global"
          ]
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "origin": {
          "type": "string",
          "maxLength": 2048
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_uri": {
          "type": "string",
          "maxLength": 4096
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "verificationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "revision_sequence"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "verificationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "request_id"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/verificationItem"
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "verificationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "results",
        "request_id"
      ],
      "properties": {
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "requested_revision_sequence",
              "status"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 3,
                "maxLength": 1024,
                "pattern": "^(memory|knowledge):.+"
              },
              "requested_revision_sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "status": {
                "enum": [
                  "current",
                  "stale",
                  "tombstoned",
                  "not_found"
                ]
              },
              "canonical_revision_sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "request_id"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "scope",
        "mode",
        "context_budget"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "mode": {
          "enum": [
            "prompt_recall",
            "interactive",
            "lookup"
          ]
        },
        "context_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "model",
            "max"
          ],
          "properties": {
            "unit": {
              "const": "provider_tokens"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32000
            }
          }
        },
        "exact_identifiers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 32,
          "minItems": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_revision",
        "revision_sequence",
        "chunk_id",
        "text",
        "freshness"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1024,
          "pattern": "^(memory|knowledge):.+"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "chunk_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "text": {
          "type": "string",
          "maxLength": 65536
        },
        "freshness": {
          "enum": [
            "verified_current",
            "stale",
            "tombstoned",
            "not_found",
            "unverified"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "status",
        "candidates",
        "degraded",
        "degradation_reasons"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "failed"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          },
          "maxItems": 100,
          "minItems": 0
        },
        "degraded": {
          "type": "boolean"
        },
        "degradation_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 20,
          "minItems": 0
        },
        "context": {
          "type": "string",
          "maxLength": 65536
        }
      }
    },
    "sourceId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1024,
      "pattern": "^(memory|knowledge):.+"
    }
  },
  "x-request-oneOf": [
    {
      "$ref": "#/$defs/request"
    }
  ],
  "x-response-oneOf": [
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ],
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ]
}
