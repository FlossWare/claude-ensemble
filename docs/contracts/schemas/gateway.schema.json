{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flossware.dev/claude-ensemble/schemas/gateway.schema.json",
  "title": "Claude Ensemble gateway Contract Schema",
  "description": "Normative JSON request/response schemas. HTTP headers, status codes, deadlines, idempotency, and lifecycle invariants are specified in the linked service contract.",
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "visibility"
      ],
      "properties": {
        "type": {
          "enum": [
            "user",
            "project",
            "shared",
            "global"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "visibility": {
          "enum": [
            "private",
            "shared",
            "global"
          ]
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "origin": {
          "type": "string",
          "maxLength": 2048
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_uri": {
          "type": "string",
          "maxLength": 4096
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "verificationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "revision_sequence"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "verificationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "request_id"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/verificationItem"
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "verificationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "results",
        "request_id"
      ],
      "properties": {
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "requested_revision_sequence",
              "status"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 3,
                "maxLength": 1024,
                "pattern": "^(memory|knowledge):[A-Za-z0-9_-]+$"
              },
              "requested_revision_sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "status": {
                "enum": [
                  "current",
                  "stale",
                  "tombstoned",
                  "not_found"
                ]
              },
              "canonical_revision_sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "request_id"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "scope",
        "mode",
        "context_budget"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "mode": {
          "enum": [
            "prompt_recall",
            "interactive",
            "lookup"
          ]
        },
        "context_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "model",
            "max"
          ],
          "properties": {
            "unit": {
              "const": "provider_tokens"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32000
            }
          }
        },
        "exact_identifiers": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "after_operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_revision",
        "revision_sequence",
        "chunk_id",
        "text",
        "freshness",
        "chunker"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1024,
          "pattern": "^(memory|knowledge):[A-Za-z0-9_-]+$"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "chunk_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "text": {
          "type": "string",
          "maxLength": 65536
        },
        "freshness": {
          "enum": [
            "verified_current",
            "stale",
            "tombstoned",
            "not_found",
            "pending_index",
            "unverified"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "chunker": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "version"
          ],
          "properties": {
            "profile": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        },
        "matched_exact_identifiers": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "status",
        "candidates",
        "degraded",
        "degradation_reasons",
        "failures",
        "index_freshness"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "failed"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          },
          "maxItems": 100,
          "minItems": 0
        },
        "degraded": {
          "type": "boolean"
        },
        "degradation_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 20,
          "minItems": 0
        },
        "context": {
          "type": "string",
          "maxLength": 65536
        },
        "index_freshness": {
          "enum": [
            "current",
            "pending_index",
            "unknown"
          ]
        },
        "failures": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "service",
              "code",
              "retryable"
            ],
            "properties": {
              "service": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "retryable": {
                "type": "boolean"
              }
            }
          }
        },
        "freshness": {
          "enum": [
            "verified_current",
            "stale",
            "tombstoned",
            "not_found",
            "pending_index",
            "unverified"
          ]
        }
      }
    },
    "sourceId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1024,
      "pattern": "^(memory|knowledge):[A-Za-z0-9_-]+$"
    },
    "selectionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id",
        "policy",
        "eligible_arms"
      ],
      "properties": {
        "context_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "policy": {
          "$ref": "#/$defs/profile"
        },
        "eligible_arms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "arm_id"
            ],
            "properties": {
              "arm_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "features": {
                "type": "object",
                "maxProperties": 100
              }
            }
          },
          "maxItems": 100,
          "minItems": 1
        },
        "expected_state_version": {
          "type": "integer",
          "minimum": 0
        },
        "request_id": {
          "$ref": "#/$defs/request/properties/request_id"
        }
      }
    },
    "outcomeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "selection_id",
        "context_id",
        "arm_id",
        "outcome",
        "evidence",
        "occurred_at",
        "policy_version"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "selection_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "context_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "arm_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "outcome": {
          "type": "object",
          "maxProperties": 100
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "maxItems": 100,
          "minItems": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "request_id": {
          "$ref": "#/$defs/request/properties/request_id"
        }
      }
    },
    "selectionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "selection_id",
        "chosen_arm_id",
        "policy",
        "state_version",
        "evidence"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request/properties/request_id"
        },
        "selection_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "chosen_arm_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "policy": {
          "$ref": "#/$defs/profile"
        },
        "state_version": {
          "type": "integer",
          "minimum": 0
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "maxItems": 100,
          "minItems": 0
        }
      }
    },
    "outcomeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "event_id",
        "operation_id",
        "status"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request/properties/request_id"
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "enum": [
            "accepted",
            "rejected",
            "pending",
            "complete",
            "failed",
            "reconciliation_required"
          ]
        }
      }
    }
  },
  "x-request-oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/selectionRequest"
    },
    {
      "$ref": "#/$defs/outcomeRequest"
    }
  ],
  "x-response-oneOf": [
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/errorResponse"
    },
    {
      "$ref": "#/$defs/selectionResponse"
    },
    {
      "$ref": "#/$defs/outcomeResponse"
    }
  ],
  "anyOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/selectionRequest"
    },
    {
      "$ref": "#/$defs/outcomeRequest"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/errorResponse"
    },
    {
      "$ref": "#/$defs/selectionResponse"
    },
    {
      "$ref": "#/$defs/outcomeResponse"
    }
  ]
}
