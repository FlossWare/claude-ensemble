{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flossware.dev/claude-ensemble/schemas/gateway.schema.json",
  "title": "Claude Ensemble gateway Contract Schema",
  "description": "Normative JSON request/response schemas. HTTP headers, status codes, deadlines, idempotency, and lifecycle invariants are specified in the linked service contract.",
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "visibility"
      ],
      "properties": {
        "type": {
          "enum": [
            "user",
            "project",
            "shared",
            "global"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "visibility": {
          "enum": [
            "private",
            "shared",
            "global"
          ]
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "origin": {
          "type": "string",
          "maxLength": 2048
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_uri": {
          "type": "string",
          "maxLength": 4096
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "verificationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "revision_sequence"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "verificationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "request_id"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/verificationItem"
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "verificationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "results",
        "request_id"
      ],
      "properties": {
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "requested_revision_sequence",
              "status"
            ],
            "properties": {
              "source_id": {
                "$ref": "#/$defs/sourceId"
              },
              "requested_revision_sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "status": {
                "enum": [
                  "current",
                  "stale",
                  "tombstoned",
                  "not_found"
                ]
              },
              "canonical_revision_sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "request_id"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "enum": [
                "invalid_request",
                "invalid_parameter",
                "not_found",
                "endpoint_not_found",
                "conflict",
                "idempotency_conflict",
                "idempotency_key_expired",
                "revision_conflict",
                "revision_sequence_regression",
                "generation_not_caught_up",
                "generation_not_found",
                "profile_not_found",
                "profile_retired",
                "profile_invalid",
                "profile_digest_mismatch",
                "profile_mismatch",
                "unsupported_profile",
                "unsupported_policy",
                "incompatible_representation",
                "source_too_large",
                "request_too_large",
                "source_unavailable",
                "source_tombstoned",
                "source_revision_mismatch",
                "duplicate_list_id",
                "duplicate_retrieval_rank",
                "candidate_identity_conflict",
                "invalid_candidate",
                "invalid_node",
                "missing_endpoint_node",
                "traversal_limit_exceeded",
                "invalid_embedding_mode",
                "vector_dimension_mismatch",
                "tokenization_failed",
                "invalid_scope",
                "local_access_denied",
                "not_ready",
                "cutover_in_progress",
                "fence_expired",
                "fence_released",
                "invalid_fence",
                "operation_not_found",
                "dependency_unavailable",
                "service_unavailable",
                "rate_limited",
                "unsupported_media_type",
                "upstream_failure",
                "deadline_exceeded",
                "context_assembly_failed",
                "internal_error",
                "reconciliation_required",
                "operation_failed",
                "sequence_regression"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "scope",
        "mode",
        "context_budget"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "mode": {
          "enum": [
            "prompt_recall",
            "interactive",
            "lookup"
          ]
        },
        "context_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "model",
            "max"
          ],
          "properties": {
            "unit": {
              "const": "provider_tokens"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32000
            }
          }
        },
        "exact_identifiers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 32,
          "minItems": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "after_operation_id": {
          "type": "string",
          "minLength": 11,
          "maxLength": 140,
          "pattern": "^(memory|knowledge):op:[A-Za-z0-9._~-]{1,128}$"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_revision",
        "revision_sequence",
        "chunk_id",
        "chunker",
        "text",
        "freshness",
        "rank",
        "score",
        "score_semantics",
        "evidence",
        "provenance"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "chunk_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "chunker": {
          "$ref": "#/$defs/chunker"
        },
        "text": {
          "type": "string",
          "maxLength": 65536
        },
        "freshness": {
          "const": "verified_current"
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "score_semantics": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "matched_exact_identifiers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 32
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "maxProperties": 20
          },
          "maxItems": 100
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "status",
        "candidates",
        "degraded",
        "degradation_reasons",
        "failures",
        "plan",
        "index_freshness",
        "truncated"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "failed"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          },
          "maxItems": 100,
          "minItems": 0
        },
        "degraded": {
          "type": "boolean"
        },
        "degradation_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 20,
          "minItems": 0
        },
        "context": {
          "type": "string",
          "maxLength": 65536
        },
        "index_freshness": {
          "enum": [
            "current",
            "pending_index",
            "unknown"
          ]
        },
        "failures": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "service",
              "code",
              "retryable"
            ],
            "properties": {
              "service": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "retryable": {
                "type": "boolean"
              }
            }
          }
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "truncated": {
          "type": "boolean"
        },
        "graph_evidence": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path_id",
              "node_ids",
              "edges"
            ],
            "properties": {
              "path_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "node_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "edges": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "edge_id",
                    "source_node_id",
                    "target_node_id",
                    "relationship_type",
                    "supports"
                  ],
                  "properties": {
                    "edge_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "source_node_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "target_node_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "relationship_type": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "supports": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 100,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "source_id",
                          "source_revision",
                          "revision_sequence"
                        ],
                        "properties": {
                          "source_id": {
                            "$ref": "#/$defs/sourceId"
                          },
                          "source_revision": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          },
                          "revision_sequence": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "sourceId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 138,
      "pattern": "^(memory|knowledge):[A-Za-z0-9._~-]{1,128}$"
    },
    "selectionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id",
        "policy",
        "eligible_arms"
      ],
      "properties": {
        "context_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "policy": {
          "$ref": "#/$defs/profile"
        },
        "eligible_arms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "arm_id"
            ],
            "properties": {
              "arm_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "features": {
                "type": "object",
                "maxProperties": 100
              }
            }
          },
          "maxItems": 100,
          "minItems": 1
        },
        "expected_state_version": {
          "type": "integer",
          "minimum": 0
        },
        "request_id": {
          "$ref": "#/$defs/request/properties/request_id"
        }
      }
    },
    "outcomeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "selection_id",
        "context_id",
        "arm_id",
        "outcome",
        "evidence",
        "occurred_at",
        "policy_version"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "selection_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "context_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "arm_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "outcome": {
          "type": "object",
          "maxProperties": 100
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "maxItems": 100,
          "minItems": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "request_id": {
          "$ref": "#/$defs/request/properties/request_id"
        }
      }
    },
    "selectionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "selection_id",
        "chosen_arm_id",
        "policy",
        "state_version",
        "evidence"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request/properties/request_id"
        },
        "selection_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "chosen_arm_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "policy": {
          "$ref": "#/$defs/profile"
        },
        "state_version": {
          "type": "integer",
          "minimum": 0
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "maxItems": 100,
          "minItems": 0
        }
      }
    },
    "outcomeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "event_id",
        "operation_id",
        "status"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/request/properties/request_id"
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "enum": [
            "accepted",
            "rejected",
            "pending",
            "complete",
            "failed",
            "reconciliation_required"
          ]
        }
      }
    },
    "chunker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "version"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "variants_used",
        "policy_version"
      ],
      "properties": {
        "intent": {
          "enum": [
            "memory_recall",
            "knowledge_lookup",
            "relationship_exploration",
            "troubleshooting",
            "explanation",
            "decision_support",
            "general"
          ]
        },
        "variants_used": {
          "const": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "x-endpoints": {
    "POST /api/v1/requests": {
      "request": "$defs/request",
      "response": "$defs/response",
      "success_status": 200,
      "error_response": "$defs/errorResponse",
      "error_statuses": [
        400,
        404,
        409,
        413,
        422,
        429,
        500,
        503,
        504
      ]
    },
    "POST /api/v1/selections": {
      "request": "$defs/selectionRequest",
      "response": "$defs/selectionResponse",
      "success_status": 200,
      "error_response": "$defs/errorResponse",
      "error_statuses": [
        400,
        404,
        409,
        413,
        422,
        429,
        500,
        503,
        504
      ]
    },
    "POST /api/v1/outcomes": {
      "request": "$defs/outcomeRequest",
      "response": "$defs/outcomeResponse",
      "success_status": 202,
      "error_response": "$defs/errorResponse",
      "error_statuses": [
        400,
        404,
        409,
        413,
        422,
        429,
        500,
        503,
        504
      ]
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/selectionRequest"
    },
    {
      "$ref": "#/$defs/selectionResponse"
    },
    {
      "$ref": "#/$defs/outcomeRequest"
    },
    {
      "$ref": "#/$defs/outcomeResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ]
}
