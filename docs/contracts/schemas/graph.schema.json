{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flossware.dev/claude-ensemble/schemas/graph.schema.json",
  "title": "Claude Ensemble graph Contract Schema",
  "description": "Normative JSON request/response schemas. HTTP headers, status codes, deadlines, idempotency, and lifecycle invariants are specified in the linked service contract.",
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "visibility"
      ],
      "properties": {
        "type": {
          "enum": [
            "user",
            "project",
            "shared",
            "global"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "visibility": {
          "enum": [
            "private",
            "shared",
            "global"
          ]
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "origin": {
          "type": "string",
          "maxLength": 2048
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_uri": {
          "type": "string",
          "maxLength": 4096
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "verificationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "revision_sequence"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "verificationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "request_id"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/verificationItem"
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "verificationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "results",
        "request_id"
      ],
      "properties": {
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "requested_revision_sequence",
              "status"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 8,
                "maxLength": 138,
                "pattern": "^(memory|knowledge):[A-Za-z0-9._~-]{1,128}$"
              },
              "requested_revision_sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "status": {
                "enum": [
                  "current",
                  "stale",
                  "tombstoned",
                  "not_found"
                ]
              },
              "canonical_revision_sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "request_id"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "enum": [
                "invalid_request",
                "invalid_parameter",
                "not_found",
                "endpoint_not_found",
                "conflict",
                "idempotency_conflict",
                "idempotency_key_expired",
                "revision_conflict",
                "revision_sequence_regression",
                "generation_not_caught_up",
                "generation_not_found",
                "profile_not_found",
                "profile_retired",
                "profile_invalid",
                "profile_digest_mismatch",
                "profile_mismatch",
                "unsupported_profile",
                "unsupported_policy",
                "incompatible_representation",
                "source_too_large",
                "request_too_large",
                "source_unavailable",
                "source_tombstoned",
                "source_revision_mismatch",
                "duplicate_list_id",
                "duplicate_retrieval_rank",
                "candidate_identity_conflict",
                "invalid_candidate",
                "invalid_node",
                "missing_endpoint_node",
                "traversal_limit_exceeded",
                "invalid_embedding_mode",
                "vector_dimension_mismatch",
                "tokenization_failed",
                "invalid_scope",
                "local_access_denied",
                "not_ready",
                "cutover_in_progress",
                "fence_expired",
                "fence_released",
                "invalid_fence",
                "operation_not_found",
                "dependency_unavailable",
                "service_unavailable",
                "rate_limited",
                "unsupported_media_type",
                "upstream_failure",
                "deadline_exceeded",
                "context_assembly_failed",
                "internal_error",
                "reconciliation_required",
                "operation_failed",
                "sequence_regression"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "node_type",
        "label"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "node_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "properties": {
          "type": "object",
          "maxProperties": 100
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "source_node_id",
        "target_node_id",
        "relationship_type",
        "directed"
      ],
      "properties": {
        "edge_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "source_node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "target_node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "relationship_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "directed": {
          "type": "boolean"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "projectionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "source_id",
        "source_revision",
        "revision_sequence",
        "scope",
        "nodes",
        "edges",
        "owner_projection_sequence"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "maxItems": 256,
          "minItems": 0
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          },
          "maxItems": 512,
          "minItems": 0
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "owner_projection_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "deleteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "source_id",
        "revision_sequence",
        "scope",
        "delete_scope",
        "owner_projection_sequence"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "delete_scope": {
          "const": "source"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "owner_projection_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "traversalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "start_node_ids",
        "max_depth",
        "limit"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "start_node_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "maxItems": 100,
          "minItems": 1
        },
        "relationship_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 100,
          "minItems": 0
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "operationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "status",
        "request_id"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "accepted",
            "pending",
            "complete",
            "failed",
            "reconciliation_required"
          ]
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "sourceId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 138,
      "pattern": "^(memory|knowledge):[A-Za-z0-9._~-]{1,128}$"
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_revision",
        "revision_sequence",
        "scope"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "traversalEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "source_node_id",
        "target_node_id",
        "relationship_type",
        "directed",
        "supports"
      ],
      "properties": {
        "edge_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "source_node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "target_node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "relationship_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "directed": {
          "type": "boolean"
        },
        "supports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/support"
          }
        }
      }
    },
    "traversalPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_id",
        "node_ids",
        "edges"
      ],
      "properties": {
        "path_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "node_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/traversalEdge"
          }
        }
      }
    },
    "traversalResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "paths",
        "truncated",
        "request_id"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "paths": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/traversalPath"
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "next_page_token": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "manifestRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limit",
        "request_id"
      ],
      "properties": {
        "cursor": {
          "type": "string",
          "maxLength": 512
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "manifestItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "revision_sequence",
        "status"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "active",
            "tombstoned",
            "reconciliation_required"
          ]
        }
      }
    },
    "manifestResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "next_cursor",
        "request_id"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/manifestItem"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "owner_watermarks": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maxProperties": 2
        },
        "ready": {
          "type": "boolean"
        }
      }
    },
    "reconciliationCheckpointRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "sealed_projection_sequence",
        "request_id"
      ],
      "properties": {
        "owner": {
          "enum": [
            "memory",
            "knowledge"
          ]
        },
        "sealed_projection_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "reconciliationCheckpointResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "sealed_projection_sequence",
        "applied_projection_sequence",
        "ready",
        "request_id"
      ],
      "properties": {
        "owner": {
          "enum": [
            "memory",
            "knowledge"
          ]
        },
        "sealed_projection_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "applied_projection_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ready": {
          "type": "boolean"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "x-endpoints": {
    "POST /api/v1/graph/source-projections": {
      "request": "#/$defs/projectionRequest",
      "response": "#/$defs/operationResponse",
      "success_status": 202,
      "error_response": "#/$defs/errorResponse",
      "error_statuses": [
        400,
        404,
        409,
        413,
        422,
        429,
        500,
        503,
        504
      ]
    },
    "POST /api/v1/graph/source-deletions": {
      "request": "#/$defs/deleteRequest",
      "response": "#/$defs/operationResponse",
      "success_status": 202,
      "error_response": "#/$defs/errorResponse",
      "error_statuses": [
        400,
        404,
        409,
        413,
        422,
        429,
        500,
        503,
        504
      ]
    },
    "POST /api/v1/graph/traversals": {
      "request": "#/$defs/traversalRequest",
      "response": "#/$defs/traversalResponse",
      "success_status": 200,
      "error_response": "#/$defs/errorResponse",
      "error_statuses": [
        400,
        404,
        409,
        413,
        422,
        429,
        500,
        503,
        504
      ]
    },
    "GET /api/v1/graph/operations/{operation_id}": {
      "response": "#/$defs/operationResponse",
      "success_status": 200,
      "error_response": "#/$defs/errorResponse",
      "error_statuses": [
        400,
        404,
        429,
        500,
        503,
        504
      ]
    },
    "GET /api/v1/graph/sources/manifest": {
      "request": "#/$defs/manifestRequest",
      "response": "#/$defs/manifestResponse",
      "success_status": 200,
      "error_response": "#/$defs/errorResponse",
      "error_statuses": [
        400,
        404,
        429,
        500,
        503,
        504
      ]
    },
    "POST /api/v1/graph/reconciliation/checkpoints": {
      "request": "#/$defs/reconciliationCheckpointRequest",
      "response": "#/$defs/reconciliationCheckpointResponse",
      "success_status": 200,
      "error_response": "#/$defs/errorResponse",
      "error_statuses": [
        400,
        409,
        429,
        500,
        503,
        504
      ]
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/projectionRequest"
    },
    {
      "$ref": "#/$defs/operationResponse"
    },
    {
      "$ref": "#/$defs/deleteRequest"
    },
    {
      "$ref": "#/$defs/traversalRequest"
    },
    {
      "$ref": "#/$defs/traversalResponse"
    },
    {
      "$ref": "#/$defs/manifestRequest"
    },
    {
      "$ref": "#/$defs/manifestResponse"
    },
    {
      "$ref": "#/$defs/reconciliationCheckpointRequest"
    },
    {
      "$ref": "#/$defs/reconciliationCheckpointResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ]
}
