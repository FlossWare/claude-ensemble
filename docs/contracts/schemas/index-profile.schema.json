{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flossware.dev/claude-ensemble/schemas/index-profile.schema.json",
  "title": "Claude Ensemble Index Profile Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "status",
    "chunking",
    "tokenization",
    "lexical",
    "embedding",
    "limits",
    "digest"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "status": {
      "enum": [
        "active",
        "deprecated",
        "retired"
      ]
    },
    "chunking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "version",
        "max_units"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "max_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        }
      }
    },
    "tokenization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "version"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "lexical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "version",
        "statistics_policy"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "statistics_policy": {
          "enum": [
            "scope_partition",
            "isolated_corpus"
          ]
        }
      }
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "profile",
        "version",
        "model",
        "model_version",
        "input_types",
        "dimensions",
        "normalization",
        "metric"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "input_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "query",
              "document"
            ]
          }
        },
        "dimensions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "normalization": {
          "enum": [
            "none",
            "l2"
          ]
        },
        "metric": {
          "enum": [
            "cosine",
            "dot_product",
            "euclidean"
          ]
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_chunks",
        "max_source_bytes",
        "max_chunk_text_bytes",
        "max_request_bytes"
      ],
      "properties": {
        "max_chunks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "max_source_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "max_chunk_text_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "max_request_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 2097152
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    }
  }
}
