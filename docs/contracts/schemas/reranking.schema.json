{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flossware.dev/claude-ensemble/schemas/reranking.schema.json",
  "title": "Claude Ensemble Reranking Contract Schema",
  "description": "Normative Reranking request/response schemas. Identity preservation and fallback semantics are specified in RERANKING.md.",
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "chunker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "version"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_revision",
        "revision_sequence",
        "chunk_id",
        "chunker",
        "text",
        "prior_rank",
        "matched_exact_identifiers"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 138,
          "pattern": "^(memory|knowledge):[A-Za-z0-9._~-]{1,128}$"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "chunk_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "chunker": {
          "$ref": "#/$defs/chunker"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "prior_rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "prior_score": {
          "type": "number"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": true
        },
        "matched_exact_identifiers": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "profile",
        "candidates",
        "limit"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "rerankedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_revision",
        "revision_sequence",
        "chunk_id",
        "chunker",
        "rerank",
        "score_semantics",
        "text",
        "matched_exact_identifiers"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 138,
          "pattern": "^(memory|knowledge):[A-Za-z0-9._~-]{1,128}$"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "chunk_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "chunker": {
          "$ref": "#/$defs/chunker"
        },
        "rerank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "score": {
          "type": "number"
        },
        "score_semantics": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "provenance": {
          "type": "object",
          "additionalProperties": true
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "evidence": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": true
        },
        "matched_exact_identifiers": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "candidates",
        "request_id"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "candidates": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/rerankedCandidate"
          }
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "request_id"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "enum": [
                "active_generation_cannot_be_abandoned",
                "candidate_identity_conflict",
                "conflict",
                "context_assembly_failed",
                "cutover_in_progress",
                "deadline_exceeded",
                "dependency_unavailable",
                "duplicate_list_id",
                "duplicate_retrieval_rank",
                "endpoint_not_found",
                "fence_expired",
                "fence_released",
                "generation_not_caught_up",
                "generation_not_found",
                "graph_replay_incomplete",
                "idempotency_conflict",
                "idempotency_key_expired",
                "incompatible_representation",
                "internal_error",
                "invalid_candidate",
                "invalid_embedding_mode",
                "invalid_fence",
                "invalid_node",
                "invalid_parameter",
                "invalid_request",
                "invalid_scope",
                "local_access_denied",
                "method_not_allowed",
                "missing_endpoint_node",
                "not_found",
                "not_ready",
                "operation_failed",
                "operation_not_found",
                "profile_digest_mismatch",
                "profile_invalid",
                "profile_mismatch",
                "profile_not_found",
                "profile_retired",
                "rate_limited",
                "reconciliation_required",
                "request_timeout",
                "request_too_large",
                "revision_conflict",
                "revision_sequence_regression",
                "sequence_regression",
                "service_unavailable",
                "source_revision_mismatch",
                "source_tombstoned",
                "source_too_large",
                "source_unavailable",
                "tokenization_failed",
                "traversal_limit_exceeded",
                "unsupported_media_type",
                "unsupported_policy",
                "unsupported_profile",
                "upstream_failure",
                "vector_dimension_mismatch"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "healthResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "status",
        "request_id"
      ],
      "properties": {
        "service": {
          "const": "reranking"
        },
        "status": {
          "const": "alive"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "readinessResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "status",
        "ready",
        "checks",
        "request_id"
      ],
      "properties": {
        "service": {
          "const": "reranking"
        },
        "status": {
          "enum": [
            "ready",
            "not_ready",
            "degraded"
          ]
        },
        "ready": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "status": {
                "enum": [
                  "ok",
                  "not_ready",
                  "degraded"
                ]
              },
              "code": {
                "type": "string",
                "maxLength": 128
              }
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "x-endpoints": {
    "POST /api/v1/reranking/rerank": {
      "request": "#/$defs/request",
      "response": "#/$defs/response",
      "success_status": 200,
      "error_response": "#/$defs/errorResponse",
      "error_statuses": [
        400,
        404,
        405,
        408,
        409,
        413,
        422,
        429,
        500,
        503,
        504
      ],
      "x-callers": [
        "gateway"
      ]
    },
    "GET /api/v1/reranking/health": {
      "response": "#/$defs/healthResponse",
      "success_status": 200,
      "error_response": "#/$defs/errorResponse",
      "error_statuses": [
        405,
        429,
        500,
        503
      ],
      "x-callers": [
        "health-probe"
      ]
    },
    "GET /api/v1/reranking/ready": {
      "response": "#/$defs/readinessResponse",
      "success_status": 200,
      "error_response": "#/$defs/errorResponse",
      "error_statuses": [
        405,
        429,
        500,
        503
      ],
      "x-callers": [
        "health-probe"
      ]
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/healthResponse"
    },
    {
      "$ref": "#/$defs/readinessResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ]
}
