{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flossware.dev/claude-ensemble/schemas/entity-extraction.schema.json",
  "title": "Claude Ensemble Entity and Identifier Extraction Contract",
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "text",
        "profile"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "maxLength": 262144
        },
        "profile": {
          "$ref": "#/$defs/profile"
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text",
        "normalized",
        "start_offset",
        "end_offset",
        "confidence",
        "exact"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "normalized": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "start_offset": {
          "type": "integer",
          "minimum": 0
        },
        "end_offset": {
          "type": "integer",
          "minimum": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "exact": {
          "type": "boolean"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "profile",
        "entities"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "entities": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/entity"
          }
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "request_id"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "enum": [
                "active_generation_cannot_be_abandoned",
                "candidate_identity_conflict",
                "conflict",
                "context_assembly_failed",
                "cutover_in_progress",
                "deadline_exceeded",
                "dependency_unavailable",
                "duplicate_list_id",
                "duplicate_retrieval_rank",
                "endpoint_not_found",
                "fence_expired",
                "fence_released",
                "generation_not_caught_up",
                "generation_not_found",
                "graph_replay_incomplete",
                "idempotency_conflict",
                "idempotency_key_expired",
                "incompatible_representation",
                "internal_error",
                "invalid_candidate",
                "invalid_embedding_mode",
                "invalid_fence",
                "invalid_node",
                "invalid_parameter",
                "invalid_request",
                "invalid_scope",
                "local_access_denied",
                "missing_endpoint_node",
                "not_found",
                "not_ready",
                "operation_failed",
                "operation_not_found",
                "profile_digest_mismatch",
                "profile_invalid",
                "profile_mismatch",
                "profile_not_found",
                "profile_retired",
                "rate_limited",
                "reconciliation_required",
                "request_too_large",
                "revision_conflict",
                "revision_sequence_regression",
                "sequence_regression",
                "service_unavailable",
                "source_revision_mismatch",
                "source_tombstoned",
                "source_too_large",
                "source_unavailable",
                "tokenization_failed",
                "traversal_limit_exceeded",
                "unsupported_media_type",
                "unsupported_policy",
                "unsupported_profile",
                "upstream_failure",
                "vector_dimension_mismatch"
              ]
            },
            "message": {
              "type": "string",
              "maxLength": 1024
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object",
              "additionalProperties": true,
              "maxProperties": 32
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "healthResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "status",
        "request_id"
      ],
      "properties": {
        "service": {
          "const": "entity-extraction"
        },
        "status": {
          "const": "alive"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "readinessResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "status",
        "ready",
        "checks",
        "request_id"
      ],
      "properties": {
        "service": {
          "const": "entity-extraction"
        },
        "status": {
          "enum": [
            "ready",
            "not_ready",
            "degraded"
          ]
        },
        "ready": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "status": {
                "enum": [
                  "ok",
                  "not_ready",
                  "degraded"
                ]
              },
              "code": {
                "type": "string",
                "maxLength": 128
              }
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "x-endpoints": {
    "POST /api/v1/entity-extraction/extract": {
      "request": "#/$defs/request",
      "response": "#/$defs/response",
      "success_status": 200,
      "error_response": "#/$defs/errorResponse",
      "error_statuses": [
        400,
        404,
        409,
        413,
        422,
        429,
        500,
        503,
        504
      ],
      "x-callers": [
        "gateway"
      ]
    },
    "GET /api/v1/entity-extraction/health": {
      "response": "#/$defs/healthResponse",
      "success_status": 200,
      "error_response": "#/$defs/errorResponse",
      "error_statuses": [
        429,
        500,
        503
      ],
      "x-callers": [
        "health-probe"
      ]
    },
    "GET /api/v1/entity-extraction/ready": {
      "response": "#/$defs/readinessResponse",
      "success_status": 200,
      "error_response": "#/$defs/errorResponse",
      "error_statuses": [
        429,
        500,
        503
      ],
      "x-callers": [
        "health-probe"
      ]
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/healthResponse"
    },
    {
      "$ref": "#/$defs/readinessResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ]
}
