{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flossware.dev/claude-ensemble/schemas/learning.schema.json",
  "title": "Claude Ensemble learning Contract Schema",
  "description": "Normative JSON request/response schemas. HTTP headers, status codes, deadlines, idempotency, and lifecycle invariants are specified in the linked service contract.",
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "visibility"
      ],
      "properties": {
        "type": {
          "enum": [
            "user",
            "project",
            "shared",
            "global"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "visibility": {
          "enum": [
            "private",
            "shared",
            "global"
          ]
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "origin": {
          "type": "string",
          "maxLength": 2048
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_uri": {
          "type": "string",
          "maxLength": 4096
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "verificationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "revision_sequence"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "verificationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "request_id"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/verificationItem"
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "verificationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "results",
        "request_id"
      ],
      "properties": {
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "requested_revision_sequence",
              "status"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 10,
                "maxLength": 138,
                "pattern": "^(memory|knowledge):[A-Za-z0-9._~-]{1,128}$"
              },
              "requested_revision_sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "status": {
                "enum": [
                  "current",
                  "stale",
                  "tombstoned",
                  "not_found"
                ]
              },
              "canonical_revision_sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "request_id"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "outcomeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "selection_id",
        "context_id",
        "arm_id",
        "outcome",
        "evidence",
        "occurred_at",
        "policy_version"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "selection_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "context_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "arm_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "outcome": {
          "type": "object",
          "maxProperties": 100
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "maxItems": 100,
          "minItems": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "outcomeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "operation_id",
        "status",
        "request_id"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "enum": [
            "accepted",
            "rejected",
            "pending",
            "complete",
            "failed",
            "reconciliation_required"
          ]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "thompson_operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "sourceId": {
      "type": "string",
      "minLength": 10,
      "maxLength": 138,
      "pattern": "^(memory|knowledge):[A-Za-z0-9._~-]{1,128}$"
    }
  },
  "x-request-oneOf": [
    {
      "$ref": "#/$defs/outcomeRequest"
    }
  ],
  "x-response-oneOf": [
    {
      "$ref": "#/$defs/outcomeResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ],
  "oneOf": [
    {
      "$ref": "#/$defs/outcomeRequest"
    },
    {
      "$ref": "#/$defs/outcomeResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ],
  "x-endpoints": {
    "POST /api/v1/learning/outcomes": {
      "request": "$defs/outcomeRequest",
      "response": "$defs/outcomeResponse",
      "success_status": 202
    }
  }
}
