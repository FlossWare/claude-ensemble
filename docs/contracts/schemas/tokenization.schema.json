{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flossware.dev/claude-ensemble/schemas/tokenization.schema.json",
  "title": "Claude Ensemble Tokenization Contract",
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "indexProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preserve_identifiers": {
          "type": "boolean"
        },
        "include_offsets": {
          "type": "boolean"
        },
        "include_normalized_terms": {
          "type": "boolean"
        }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term",
        "surface",
        "start_offset",
        "end_offset",
        "kind"
      ],
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "start_offset": {
          "type": "integer",
          "minimum": 0
        },
        "end_offset": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "word",
            "identifier",
            "path",
            "number",
            "punctuation",
            "other"
          ]
        }
      }
    },
    "itemError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "maxLength": 1024
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index_profile",
        "text",
        "profile",
        "profile_version",
        "options"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "index_profile": {
          "$ref": "#/$defs/indexProfile"
        },
        "text": {
          "type": "string",
          "maxLength": 262144
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "profile_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "options": {
          "$ref": "#/$defs/options"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "version",
        "normalization_version",
        "index_profile",
        "tokens"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "normalization_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "index_profile": {
          "$ref": "#/$defs/indexProfile"
        },
        "tokens": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/token"
          }
        }
      }
    },
    "batchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index_profile",
        "profile",
        "profile_version",
        "inputs"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "index_profile": {
          "$ref": "#/$defs/indexProfile"
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "profile_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "options": {
          "$ref": "#/$defs/options"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input_id",
              "text"
            ],
            "properties": {
              "input_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "text": {
                "type": "string",
                "maxLength": 262144
              }
            }
          }
        }
      }
    },
    "batchResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "version",
        "normalization_version",
        "index_profile",
        "results"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "normalization_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "index_profile": {
          "$ref": "#/$defs/indexProfile"
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input_id"
            ],
            "properties": {
              "input_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "tokens": {
                "type": "array",
                "maxItems": 100000,
                "items": {
                  "$ref": "#/$defs/token"
                }
              },
              "error": {
                "$ref": "#/$defs/itemError"
              }
            }
          }
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "request_id"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "message": {
              "type": "string",
              "maxLength": 1024
            },
            "retryable": {
              "type": "boolean"
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/batchRequest"
    },
    {
      "$ref": "#/$defs/batchResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ],
  "x-endpoints": {
    "POST /api/v1/tokenization/lexical": {
      "request": "$defs/request",
      "response": "$defs/response",
      "success_status": 200
    },
    "POST /api/v1/tokenization/lexical/batch": {
      "request": "$defs/batchRequest",
      "response": "$defs/batchResponse",
      "success_status": 200
    }
  }
}
