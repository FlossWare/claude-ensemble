{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flossware.dev/claude-ensemble/schemas/tokenization.schema.json",
  "title": "Claude Ensemble Tokenization Contract",
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "indexProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preserve_identifiers": {
          "type": "boolean"
        },
        "include_offsets": {
          "type": "boolean"
        },
        "include_normalized_terms": {
          "type": "boolean"
        }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term",
        "surface",
        "kind"
      ],
      "dependentRequired": {
        "start_offset": ["end_offset"],
        "end_offset": ["start_offset"]
      },
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "start_offset": {
          "type": "integer",
          "minimum": 0
        },
        "end_offset": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "word",
            "identifier",
            "path",
            "number",
            "punctuation",
            "other"
          ]
        }
      }
    },
    "itemError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "maxLength": 1024
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index_profile",
        "text",
        "profile",
        "profile_version",
        "options"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "index_profile": {
          "$ref": "#/$defs/indexProfile"
        },
        "text": {
          "type": "string",
          "maxLength": 262144
        },
        "profile": {
          "const": "technical-default"
        },
        "profile_version": {
          "const": "0.1"
        },
        "options": {
          "$ref": "#/$defs/options"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "version",
        "normalization_version",
        "index_profile",
        "tokens"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "profile": {
          "const": "technical-default"
        },
        "version": {
          "const": "0.1"
        },
        "normalization_version": {
          "const": "0.1"
        },
        "index_profile": {
          "$ref": "#/$defs/indexProfile"
        },
        "tokens": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/token"
          }
        }
      }
    },
    "batchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index_profile",
        "profile",
        "profile_version",
        "inputs"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "index_profile": {
          "$ref": "#/$defs/indexProfile"
        },
        "profile": {
          "const": "technical-default"
        },
        "profile_version": {
          "const": "0.1"
        },
        "options": {
          "$ref": "#/$defs/options"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input_id",
              "text"
            ],
            "properties": {
              "input_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "text": {
                "type": "string",
                "maxLength": 262144
              }
            }
          }
        }
      }
    },
    "batchResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "version",
        "normalization_version",
        "index_profile",
        "results"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "profile": {
          "const": "technical-default"
        },
        "version": {
          "const": "0.1"
        },
        "normalization_version": {
          "const": "0.1"
        },
        "index_profile": {
          "$ref": "#/$defs/indexProfile"
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input_id"
            ],
            "properties": {
              "input_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "tokens": {
                "type": "array",
                "maxItems": 512,
                "items": {
                  "$ref": "#/$defs/token"
                }
              },
              "error": {
                "$ref": "#/$defs/itemError"
              }
            },
            "oneOf": [
              {
                "required": [
                  "input_id",
                  "tokens"
                ],
                "not": {
                  "required": [
                    "error"
                  ]
                }
              },
              {
                "required": [
                  "input_id",
                  "error"
                ],
                "not": {
                  "required": [
                    "tokens"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "request_id"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "enum": [
                "active_generation_cannot_be_abandoned",
                "candidate_identity_conflict",
                "conflict",
                "context_assembly_failed",
                "cutover_in_progress",
                "deadline_exceeded",
                "dependency_unavailable",
                "duplicate_list_id",
                "duplicate_retrieval_rank",
                "endpoint_not_found",
                "fence_expired",
                "fence_released",
                "generation_not_caught_up",
                "generation_not_found",
                "graph_replay_incomplete",
                "idempotency_conflict",
                "idempotency_key_expired",
                "incompatible_representation",
                "internal_error",
                "invalid_candidate",
                "invalid_embedding_mode",
                "invalid_fence",
                "invalid_node",
                "invalid_parameter",
                "invalid_request",
                "invalid_scope",
                "local_access_denied",
                "missing_endpoint_node",
                "not_found",
                "not_ready",
                "operation_failed",
                "operation_not_found",
                "profile_digest_mismatch",
                "profile_invalid",
                "profile_mismatch",
                "profile_not_found",
                "profile_retired",
                "rate_limited",
                "reconciliation_required",
                "request_too_large",
                "revision_conflict",
                "revision_sequence_regression",
                "sequence_regression",
                "service_unavailable",
                "source_revision_mismatch",
                "source_tombstoned",
                "source_too_large",
                "source_unavailable",
                "tokenization_failed",
                "traversal_limit_exceeded",
                "unsupported_media_type",
                "unsupported_policy",
                "unsupported_profile",
                "upstream_failure",
                "vector_dimension_mismatch"
              ]
            },
            "message": {
              "type": "string",
              "maxLength": 1024
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object",
              "additionalProperties": true,
              "maxProperties": 32
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "healthResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "status",
        "request_id"
      ],
      "properties": {
        "service": {
          "const": "tokenization"
        },
        "status": {
          "const": "alive"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "readinessResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "status",
        "ready",
        "checks",
        "request_id"
      ],
      "properties": {
        "service": {
          "const": "tokenization"
        },
        "status": {
          "enum": [
            "ready",
            "not_ready",
            "degraded"
          ]
        },
        "ready": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "status": {
                "enum": [
                  "ok",
                  "not_ready",
                  "degraded"
                ]
              },
              "code": {
                "type": "string",
                "maxLength": 128
              }
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "x-endpoints": {
    "POST /api/v1/tokenization/lexical": {
      "request": "#/$defs/request",
      "response": "#/$defs/response",
      "success_status": 200,
      "error_response": "#/$defs/errorResponse",
      "error_statuses": [
        400,
        404,
        409,
        413,
        415,
        422,
        429,
        500,
        503,
        504
      ],
      "x-callers": [
        "memory",
        "knowledge",
        "lexical-retrieval"
      ]
    },
    "POST /api/v1/tokenization/lexical/batch": {
      "request": "#/$defs/batchRequest",
      "response": "#/$defs/batchResponse",
      "success_status": 200,
      "error_response": "#/$defs/errorResponse",
      "error_statuses": [
        400,
        404,
        409,
        413,
        415,
        422,
        429,
        500,
        503,
        504
      ],
      "x-callers": [
        "memory",
        "knowledge",
        "lexical-retrieval"
      ]
    },
    "GET /api/v1/tokenization/health": {
      "response": "#/$defs/healthResponse",
      "success_status": 200,
      "error_response": "#/$defs/errorResponse",
      "error_statuses": [
        429,
        500,
        503
      ],
      "x-callers": [
        "health-probe"
      ]
    },
    "GET /api/v1/tokenization/ready": {
      "response": "#/$defs/readinessResponse",
      "success_status": 200,
      "error_response": "#/$defs/errorResponse",
      "error_statuses": [
        429,
        500,
        503
      ],
      "x-callers": [
        "health-probe"
      ]
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/batchRequest"
    },
    {
      "$ref": "#/$defs/batchResponse"
    },
    {
      "$ref": "#/$defs/healthResponse"
    },
    {
      "$ref": "#/$defs/readinessResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ]
}
