{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flossware.dev/claude-ensemble/schemas/index.schema.json",
  "title": "Claude Ensemble Index Lifecycle Contract Schema",
  "description": "Normative lifecycle request/response shapes for Index generation management. Cross-service sequencing and fencing invariants are specified in INDEX.md.",
  "$defs": {
    "sourceId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1024,
      "pattern": "^(memory|knowledge):.+"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "ownerFence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "fence_token",
        "sealed_change_cursor",
        "expires_at"
      ],
      "properties": {
        "owner": {
          "enum": [
            "memory",
            "knowledge"
          ]
        },
        "fence_token": {
          "type": "string",
          "minLength": 16,
          "maxLength": 512
        },
        "sealed_change_cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "cutoverRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_active_generation",
        "owner_fences"
      ],
      "properties": {
        "expected_active_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "owner_fences": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/ownerFence"
          },
          "allOf": [
            {
              "contains": {
                "properties": {
                  "owner": {
                    "const": "memory"
                  }
                },
                "required": [
                  "owner"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "owner": {
                    "const": "knowledge"
                  }
                },
                "required": [
                  "owner"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "generationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_id",
        "status",
        "index_profile",
        "request_id"
      ],
      "properties": {
        "generation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "enum": [
            "building",
            "eligible",
            "active",
            "abandoned",
            "failed",
            "retired"
          ]
        },
        "index_profile": {
          "$ref": "#/$defs/profile"
        },
        "applied_owner_cursors": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 512
          }
        },
        "dual_apply_journal_position": {
          "type": "string",
          "maxLength": 512
        },
        "cutover_eligible": {
          "type": "boolean"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "upsertRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "source",
        "index_profile",
        "representations"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_id",
            "revision",
            "revision_sequence",
            "scope"
          ],
          "properties": {
            "source_id": {
              "$ref": "#/$defs/sourceId"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "revision_sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "scope": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "id",
                "visibility"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "user",
                    "project",
                    "shared",
                    "global"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "visibility": {
                  "enum": [
                    "private",
                    "shared",
                    "global"
                  ]
                }
              }
            }
          }
        },
        "index_profile": {
          "$ref": "#/$defs/profile"
        },
        "target_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "representations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "deleteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "source_id",
        "source_revision",
        "revision_sequence",
        "scope",
        "index_profile",
        "delete_scope"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "visibility"
          ],
          "properties": {
            "type": {
              "enum": [
                "user",
                "project",
                "shared",
                "global"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "visibility": {
              "enum": [
                "private",
                "shared",
                "global"
              ]
            }
          }
        },
        "index_profile": {
          "$ref": "#/$defs/profile"
        },
        "delete_scope": {
          "const": "source"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "request_id"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "retryable": {
              "type": "boolean"
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "generationCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index_profile"
      ],
      "properties": {
        "index_profile": {
          "$ref": "#/$defs/profile"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/generationCreateRequest"
    },
    {
      "$ref": "#/$defs/cutoverRequest"
    },
    {
      "$ref": "#/$defs/upsertRequest"
    },
    {
      "$ref": "#/$defs/deleteRequest"
    },
    {
      "$ref": "#/$defs/generationResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ]
}
