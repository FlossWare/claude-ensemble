{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flossware.dev/claude-ensemble/schemas/index.schema.json",
  "title": "Claude Ensemble Index Lifecycle Contract Schema",
  "description": "Normative lifecycle request/response shapes for Index generation management. Cross-service sequencing and fencing invariants are specified in INDEX.md.",
  "$defs": {
    "sourceId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 138,
      "pattern": "^(memory|knowledge):[A-Za-z0-9._~-]{1,128}$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "ownerFence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "fence_token",
        "expires_at",
        "target_generation",
        "fence_id",
        "fence_state",
        "sealed_change_sequence"
      ],
      "properties": {
        "owner": {
          "enum": [
            "memory",
            "knowledge"
          ]
        },
        "fence_token": {
          "type": "string",
          "minLength": 16,
          "maxLength": 512
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "target_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "fence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "fence_state": {
          "const": "held"
        },
        "sealed_change_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "cutoverRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_active_generation",
        "owner_fences"
      ],
      "properties": {
        "expected_active_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "owner_fences": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/ownerFence"
          },
          "allOf": [
            {
              "contains": {
                "properties": {
                  "owner": {
                    "const": "memory"
                  }
                },
                "required": [
                  "owner"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "owner": {
                    "const": "knowledge"
                  }
                },
                "required": [
                  "owner"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "generationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_id",
        "status",
        "index_profile",
        "request_id"
      ],
      "properties": {
        "generation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "enum": [
            "building",
            "eligible",
            "active",
            "abandoned",
            "failed",
            "retired",
            "reconciliation_required"
          ]
        },
        "index_profile": {
          "$ref": "#/$defs/profile"
        },
        "applied_owner_cursors": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 512
          }
        },
        "dual_apply_journal_position": {
          "type": "string",
          "maxLength": 512
        },
        "cutover_eligible": {
          "type": "boolean"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "exclusions": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "reason_code"
            ],
            "properties": {
              "source_id": {
                "$ref": "#/$defs/sourceId"
              },
              "reason_code": {
                "enum": [
                  "source_too_large",
                  "unsupported_profile",
                  "incompatible_representation",
                  "source_unavailable"
                ]
              },
              "details": {
                "type": "string",
                "maxLength": 1024
              }
            }
          }
        }
      }
    },
    "upsertRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "source",
        "index_profile",
        "representations"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_id",
            "revision",
            "revision_sequence",
            "scope"
          ],
          "properties": {
            "source_id": {
              "$ref": "#/$defs/sourceId"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "revision_sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "scope": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "id",
                "visibility"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "user",
                    "project",
                    "shared",
                    "global"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "visibility": {
                  "enum": [
                    "private",
                    "shared",
                    "global"
                  ]
                }
              }
            }
          }
        },
        "index_profile": {
          "$ref": "#/$defs/profile"
        },
        "target_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "representations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chunk_id",
              "chunker",
              "text",
              "metadata"
            ],
            "properties": {
              "chunk_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "chunker": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "profile",
                  "version"
                ],
                "properties": {
                  "profile": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                }
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              },
              "lexical": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "profile",
                  "version",
                  "terms"
                ],
                "properties": {
                  "profile": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "terms": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4096,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  }
                }
              },
              "vector": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "input_type",
                  "model",
                  "version",
                  "dimensions",
                  "values"
                ],
                "properties": {
                  "input_type": {
                    "const": "document"
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "dimensions": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4096
                  },
                  "values": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4096,
                    "items": {
                      "type": "number"
                    }
                  }
                }
              },
              "metadata": {
                "type": "object",
                "maxProperties": 100
              }
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "deleteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "source_id",
        "source_revision",
        "revision_sequence",
        "scope",
        "index_profile",
        "delete_scope"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "visibility"
          ],
          "properties": {
            "type": {
              "enum": [
                "user",
                "project",
                "shared",
                "global"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "visibility": {
              "enum": [
                "private",
                "shared",
                "global"
              ]
            }
          }
        },
        "index_profile": {
          "$ref": "#/$defs/profile"
        },
        "delete_scope": {
          "const": "source"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "request_id"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "generationCreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index_profile"
      ],
      "properties": {
        "index_profile": {
          "$ref": "#/$defs/profile"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "upsertResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "source_id",
        "source_revision",
        "revision_sequence",
        "status",
        "index_generation",
        "request_id"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "accepted",
            "pending",
            "complete",
            "failed",
            "superseded",
            "reconciliation_required"
          ]
        },
        "index_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "operationStatusResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "status",
        "request_id"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "enum": [
            "accepted",
            "pending",
            "complete",
            "failed",
            "superseded",
            "reconciliation_required"
          ]
        },
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "safe_error_code": {
          "type": "string",
          "maxLength": 128
        },
        "reconciliation_required": {
          "type": "boolean"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "sourceStatusResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "latest_revision_sequence",
        "indexed_revision_sequence",
        "tombstone_sequence",
        "request_id"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "latest_revision_sequence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "indexed_revision_sequence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tombstone_sequence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "deletion_state": {
          "enum": [
            "active",
            "tombstoned",
            "unknown"
          ]
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "profileCurrentResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "digest",
        "bundle",
        "request_id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "bundle": {
          "type": "object"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "ownerCheckpointRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "applied_change_sequence",
        "request_id"
      ],
      "properties": {
        "owner": {
          "enum": [
            "memory",
            "knowledge"
          ]
        },
        "applied_change_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "ownerFenceRegistrationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "target_generation",
        "fence_id",
        "fence_token",
        "sealed_change_sequence",
        "expires_at",
        "state",
        "request_id"
      ],
      "properties": {
        "owner": {
          "enum": [
            "memory",
            "knowledge"
          ]
        },
        "target_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "fence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "fence_token": {
          "type": "string",
          "minLength": 16,
          "maxLength": 512
        },
        "sealed_change_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "const": "held"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "ownerCheckpointResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "applied_change_sequence",
        "request_id"
      ],
      "properties": {
        "owner": {
          "enum": [
            "memory",
            "knowledge"
          ]
        },
        "applied_change_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/generationCreateRequest"
    },
    {
      "$ref": "#/$defs/cutoverRequest"
    },
    {
      "$ref": "#/$defs/upsertRequest"
    },
    {
      "$ref": "#/$defs/deleteRequest"
    },
    {
      "$ref": "#/$defs/generationResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    },
    {
      "$ref": "#/$defs/upsertResponse"
    },
    {
      "$ref": "#/$defs/operationStatusResponse"
    },
    {
      "$ref": "#/$defs/sourceStatusResponse"
    },
    {
      "$ref": "#/$defs/profileCurrentResponse"
    },
    {
      "$ref": "#/$defs/ownerCheckpointRequest"
    },
    {
      "$ref": "#/$defs/ownerFenceRegistrationRequest"
    },
    {
      "$ref": "#/$defs/ownerCheckpointResponse"
    }
  ],
  "x-endpoints": {
    "POST /api/v1/index/operations/upsert": {
      "request": "$defs/upsertRequest",
      "response": "$defs/upsertResponse",
      "success_status": 202
    },
    "POST /api/v1/index/operations/delete": {
      "request": "$defs/deleteRequest",
      "response": "$defs/upsertResponse",
      "success_status": 202
    },
    "GET /api/v1/index/operations/{operation_id}": {
      "response": "$defs/operationStatusResponse",
      "success_status": 200
    },
    "GET /api/v1/index/sources/{source_id}/status": {
      "response": "$defs/sourceStatusResponse",
      "success_status": 200
    },
    "GET /api/v1/index/profiles/{profile_name}/current": {
      "response": "$defs/profileCurrentResponse",
      "success_status": 200
    },
    "POST /api/v1/index/generations": {
      "request": "$defs/generationCreateRequest",
      "response": "$defs/generationResponse",
      "success_status": 202
    },
    "POST /api/v1/index/generations/{generation_id}/cutover": {
      "request": "$defs/cutoverRequest",
      "response": "$defs/generationResponse",
      "success_status": 200
    },
    "PUT /api/v1/index/generations/{generation_id}/owner-fences/{owner}/{fence_id}": {
      "request": "$defs/ownerFenceRegistrationRequest",
      "success_status": 200
    },
    "DELETE /api/v1/index/generations/{generation_id}/owner-fences/{owner}/{fence_id}": {
      "success_status": 200
    },
    "POST /api/v1/index/generations/{generation_id}/owner-checkpoints": {
      "request": "$defs/ownerCheckpointRequest",
      "response": "$defs/ownerCheckpointResponse",
      "success_status": 200
    },
    "GET /api/v1/index/profiles/{profile_name}/versions/{profile_version}": {
      "response": "$defs/profileCurrentResponse",
      "success_status": 200
    },
    "POST /api/v1/index/generations/{generation_id}/abandon": {
      "request": "$defs/generationCreateRequest",
      "response": "$defs/generationResponse",
      "success_status": 200
    }
  }
}
