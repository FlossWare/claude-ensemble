{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flossware.dev/claude-ensemble/schemas/memory.schema.json",
  "title": "Claude Ensemble memory Contract Schema",
  "description": "Normative JSON request/response schemas. HTTP headers, status codes, deadlines, idempotency, and lifecycle invariants are specified in the linked service contract.",
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "visibility"
      ],
      "properties": {
        "type": {
          "enum": [
            "user",
            "project",
            "shared",
            "global"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "visibility": {
          "enum": [
            "private",
            "shared",
            "global"
          ]
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "origin": {
          "type": "string",
          "maxLength": 2048
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_uri": {
          "type": "string",
          "maxLength": 4096
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "verificationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "revision_sequence"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "verificationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "request_id"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/verificationItem"
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "verificationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "results",
        "request_id"
      ],
      "properties": {
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "requested_revision_sequence",
              "status"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 3,
                "maxLength": 1024,
                "pattern": "^(memory|knowledge):.+"
              },
              "requested_revision_sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "status": {
                "enum": [
                  "current",
                  "stale",
                  "tombstoned",
                  "not_found"
                ]
              },
              "canonical_revision_sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "request_id"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "createRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "type",
        "content",
        "provenance",
        "retention_policy",
        "index_profile"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "type": {
          "enum": [
            "episodic",
            "semantic",
            "decision",
            "fact",
            "preference",
            "task"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "retention_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "standard",
                "ephemeral",
                "retained"
              ]
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "index_profile": {
          "$ref": "#/$defs/profile"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "updateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_base_revision_sequence",
        "content",
        "provenance",
        "index_profile"
      ],
      "properties": {
        "expected_base_revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "index_profile": {
          "$ref": "#/$defs/profile"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "deleteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "delete_scope"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "delete_scope": {
          "const": "source"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "createResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "memory_id",
        "revision",
        "revision_sequence",
        "status",
        "request_id",
        "indexing_status"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "memory_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "accepted",
            "pending",
            "complete",
            "failed",
            "reconciliation_required"
          ]
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "indexing_status": {
          "enum": [
            "pending_index",
            "indexed",
            "index_failed",
            "reconciliation_required"
          ]
        }
      }
    },
    "updateResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "memory_id",
        "revision",
        "revision_sequence",
        "status",
        "request_id",
        "indexing_status"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "memory_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "accepted",
            "pending",
            "complete",
            "failed",
            "reconciliation_required"
          ]
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "indexing_status": {
          "enum": [
            "pending_index",
            "indexed",
            "index_failed",
            "reconciliation_required"
          ]
        }
      }
    },
    "sourceId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1024,
      "pattern": "^memory:.+"
    },
    "deleteResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "memory_id",
        "source_id",
        "tombstone_sequence",
        "status",
        "indexing_status",
        "request_id"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "memory_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "tombstone_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "pending",
            "complete",
            "reconciliation_required"
          ]
        },
        "indexing_status": {
          "enum": [
            "pending_index",
            "indexed",
            "index_failed",
            "reconciliation_required"
          ]
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "recordResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_id",
        "source_id",
        "revision",
        "revision_sequence",
        "scope",
        "type",
        "content",
        "provenance",
        "retention_policy",
        "index_profile",
        "request_id"
      ],
      "properties": {
        "memory_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "type": {
          "enum": [
            "episodic",
            "semantic",
            "decision",
            "fact",
            "preference",
            "task"
          ]
        },
        "content": {
          "type": "string",
          "maxLength": 262144
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "retention_policy": {
          "$ref": "#/$defs/createRequest/properties/retention_policy"
        },
        "index_profile": {
          "$ref": "#/$defs/profile"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "operationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "memory_id",
        "source_id",
        "canonical_status",
        "indexing_status",
        "request_id"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "memory_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "canonical_status": {
          "enum": [
            "committed",
            "rejected"
          ]
        },
        "indexing_status": {
          "enum": [
            "pending_index",
            "indexed",
            "index_failed",
            "reconciliation_required"
          ]
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "manifestItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_id",
        "source_id",
        "scope",
        "index_profile"
      ],
      "properties": {
        "memory_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tombstone_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "index_profile": {
          "$ref": "#/$defs/profile"
        }
      },
      "anyOf": [
        {
          "required": [
            "revision",
            "revision_sequence"
          ]
        },
        {
          "required": [
            "tombstone_sequence"
          ]
        }
      ]
    },
    "manifestResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "change_cursor",
        "items",
        "request_id",
        "next_cursor"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "change_cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/manifestItem"
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "reconciliationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "target_generation"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "target_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "change_cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "reconciliationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "status",
        "target_generation",
        "request_id"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "enum": [
            "accepted",
            "pending",
            "complete",
            "failed",
            "reconciliation_required"
          ]
        },
        "target_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "x-request-oneOf": [
    {
      "$ref": "#/$defs/createRequest"
    },
    {
      "$ref": "#/$defs/updateRequest"
    },
    {
      "$ref": "#/$defs/deleteRequest"
    },
    {
      "$ref": "#/$defs/verificationRequest"
    },
    {
      "$ref": "#/$defs/reconciliationRequest"
    }
  ],
  "x-response-oneOf": [
    {
      "$ref": "#/$defs/createResponse"
    },
    {
      "$ref": "#/$defs/updateResponse"
    },
    {
      "$ref": "#/$defs/verificationResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    },
    {
      "$ref": "#/$defs/deleteResponse"
    },
    {
      "$ref": "#/$defs/recordResponse"
    },
    {
      "$ref": "#/$defs/operationResponse"
    },
    {
      "$ref": "#/$defs/manifestResponse"
    },
    {
      "$ref": "#/$defs/reconciliationResponse"
    }
  ],
  "oneOf": [
    {
      "$ref": "#/$defs/createRequest"
    },
    {
      "$ref": "#/$defs/updateRequest"
    },
    {
      "$ref": "#/$defs/deleteRequest"
    },
    {
      "$ref": "#/$defs/verificationRequest"
    },
    {
      "$ref": "#/$defs/reconciliationRequest"
    },
    {
      "$ref": "#/$defs/createResponse"
    },
    {
      "$ref": "#/$defs/updateResponse"
    },
    {
      "$ref": "#/$defs/verificationResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    },
    {
      "$ref": "#/$defs/deleteResponse"
    },
    {
      "$ref": "#/$defs/recordResponse"
    },
    {
      "$ref": "#/$defs/operationResponse"
    },
    {
      "$ref": "#/$defs/manifestResponse"
    },
    {
      "$ref": "#/$defs/reconciliationResponse"
    }
  ]
}
