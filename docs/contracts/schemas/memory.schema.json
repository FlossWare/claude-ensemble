{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flossware.dev/claude-ensemble/schemas/memory.schema.json",
  "title": "Claude Ensemble memory Contract Schema",
  "description": "Normative JSON request/response schemas. HTTP headers, status codes, deadlines, idempotency, and lifecycle invariants are specified in the linked service contract.",
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "visibility"
      ],
      "properties": {
        "type": {
          "enum": [
            "user",
            "project",
            "shared",
            "global"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "visibility": {
          "enum": [
            "private",
            "shared",
            "global"
          ]
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "origin": {
          "type": "string",
          "maxLength": 2048
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_uri": {
          "type": "string",
          "maxLength": 4096
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "verificationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "revision_sequence"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1024,
          "pattern": "^memory:.+"
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "verificationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "request_id"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/verificationItem"
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "verificationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "results",
        "request_id"
      ],
      "properties": {
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "requested_revision_sequence",
              "status"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 3,
                "maxLength": 1024,
                "pattern": "^memory:.+"
              },
              "requested_revision_sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "status": {
                "enum": [
                  "current",
                  "stale",
                  "tombstoned",
                  "not_found"
                ]
              },
              "canonical_revision_sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "request_id"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "createRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "type",
        "content",
        "provenance",
        "retention_policy",
        "index_profile"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "type": {
          "enum": [
            "episodic",
            "semantic",
            "decision",
            "fact",
            "preference",
            "task"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "retention_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "standard",
                "ephemeral",
                "retained"
              ]
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "index_profile": {
          "$ref": "#/$defs/profile"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "updateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_base_revision_sequence",
        "content",
        "provenance",
        "index_profile"
      ],
      "properties": {
        "expected_base_revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "index_profile": {
          "$ref": "#/$defs/profile"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "deleteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "delete_scope"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "delete_scope": {
          "const": "source"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "createResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "memory_id",
        "revision",
        "revision_sequence",
        "status",
        "request_id",
        "indexing_status"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 12,
          "maxLength": 256,
          "pattern": "^memory:op:.+"
        },
        "memory_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^memory:.+"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "accepted",
            "pending",
            "complete",
            "failed",
            "reconciliation_required"
          ]
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "indexing_status": {
          "enum": [
            "pending_index",
            "indexed",
            "index_failed",
            "reconciliation_required"
          ]
        }
      }
    },
    "updateResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "memory_id",
        "revision",
        "revision_sequence",
        "status",
        "request_id",
        "indexing_status"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "memory_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "accepted",
            "pending",
            "complete",
            "failed",
            "reconciliation_required"
          ]
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "indexing_status": {
          "enum": [
            "pending_index",
            "indexed",
            "index_failed",
            "reconciliation_required"
          ]
        }
      }
    },
    "sourceId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1024,
      "pattern": "^memory:.+"
    },
    "fenceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_generation",
        "snapshot_id"
      ],
      "properties": {
        "target_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "fenceResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "target_generation",
        "fence_token",
        "sealed_change_cursor",
        "expires_at",
        "request_id"
      ],
      "properties": {
        "owner": {
          "const": "memory"
        },
        "target_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "fence_token": {
          "type": "string",
          "minLength": 16,
          "maxLength": 512
        },
        "sealed_change_cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "fenceReleaseRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_generation",
        "fence_token"
      ],
      "properties": {
        "target_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "fence_token": {
          "type": "string",
          "minLength": 16,
          "maxLength": 512
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "fenceReleaseResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "target_generation",
        "released",
        "request_id"
      ],
      "properties": {
        "owner": {
          "const": "memory"
        },
        "target_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "released": {
          "type": "boolean"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "deleteResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "memory_id",
        "revision",
        "revision_sequence",
        "status",
        "request_id",
        "indexing_status"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 12,
          "maxLength": 256,
          "pattern": "^memory:op:.+"
        },
        "memory_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^memory:.+"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "accepted",
            "pending",
            "complete",
            "failed",
            "reconciliation_required"
          ]
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "indexing_status": {
          "enum": [
            "pending_index",
            "indexed",
            "index_failed",
            "reconciliation_required"
          ]
        }
      }
    },
    "operationStatusResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "status",
        "canonical_status",
        "indexing_status",
        "request_id"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^memory:op:.+",
          "minLength": 12,
          "maxLength": 256
        },
        "status": {
          "enum": [
            "accepted",
            "pending",
            "complete",
            "failed",
            "reconciliation_required"
          ]
        },
        "canonical_status": {
          "enum": [
            "committed",
            "tombstoned"
          ]
        },
        "indexing_status": {
          "enum": [
            "pending_index",
            "indexed",
            "index_failed",
            "reconciliation_required"
          ]
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "x-request-oneOf": [
    {
      "$ref": "#/$defs/createRequest"
    },
    {
      "$ref": "#/$defs/updateRequest"
    },
    {
      "$ref": "#/$defs/deleteRequest"
    },
    {
      "$ref": "#/$defs/verificationRequest"
    }
  ],
  "x-response-oneOf": [
    {
      "$ref": "#/$defs/createResponse"
    },
    {
      "$ref": "#/$defs/updateResponse"
    },
    {
      "$ref": "#/$defs/verificationResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ],
  "oneOf": [
    {
      "$ref": "#/$defs/createRequest"
    },
    {
      "$ref": "#/$defs/updateRequest"
    },
    {
      "$ref": "#/$defs/deleteRequest"
    },
    {
      "$ref": "#/$defs/verificationRequest"
    },
    {
      "$ref": "#/$defs/createResponse"
    },
    {
      "$ref": "#/$defs/verificationResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    },
    {
      "$ref": "#/$defs/fenceRequest"
    },
    {
      "$ref": "#/$defs/fenceReleaseRequest"
    },
    {
      "$ref": "#/$defs/fenceResponse"
    },
    {
      "$ref": "#/$defs/fenceReleaseResponse"
    }
  ],
  "x-endpoints": {
    "POST /api/v1/memories": {
      "request": "$defs/createRequest",
      "response": "$defs/createResponse",
      "success_status": 202
    },
    "PUT /api/v1/memories/{memory_id}": {
      "request": "$defs/updateRequest",
      "response": "$defs/createResponse",
      "success_status": 202
    },
    "DELETE /api/v1/memories/{memory_id}": {
      "request": "$defs/deleteRequest",
      "response": "$defs/deleteResponse",
      "success_status": 202
    },
    "POST /api/v1/memories/verify-revisions": {
      "request": "$defs/verificationRequest",
      "response": "$defs/verificationResponse",
      "success_status": 200
    },
    "GET /api/v1/memories/operations/{operation_id}": {
      "response": "$defs/operationStatusResponse",
      "success_status": 200
    }
  }
}
