{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flossware.dev/claude-ensemble/schemas/lexical-retrieval.schema.json",
  "title": "Claude Ensemble lexical-retrieval Contract Schema",
  "description": "Normative JSON request/response schemas. HTTP headers, status codes, deadlines, idempotency, and lifecycle invariants are specified in the linked service contract.",
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "visibility"
      ],
      "properties": {
        "type": {
          "enum": [
            "user",
            "project",
            "shared",
            "global"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "visibility": {
          "enum": [
            "private",
            "shared",
            "global"
          ]
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "origin": {
          "type": "string",
          "maxLength": 2048
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_uri": {
          "type": "string",
          "maxLength": 4096
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "verificationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "revision_sequence"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "verificationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "request_id"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/verificationItem"
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "verificationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "results",
        "request_id"
      ],
      "properties": {
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "requested_revision_sequence",
              "status"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 8,
                "maxLength": 138,
                "pattern": "^(memory|knowledge):[A-Za-z0-9._~-]{1,128}$"
              },
              "requested_revision_sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "status": {
                "enum": [
                  "current",
                  "stale",
                  "tombstoned",
                  "not_found"
                ]
              },
              "canonical_revision_sequence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "request_id"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "enum": [
                "invalid_request",
                "invalid_parameter",
                "not_found",
                "endpoint_not_found",
                "conflict",
                "idempotency_conflict",
                "idempotency_key_expired",
                "revision_conflict",
                "revision_sequence_regression",
                "generation_not_caught_up",
                "generation_not_found",
                "profile_not_found",
                "profile_retired",
                "profile_invalid",
                "profile_digest_mismatch",
                "profile_mismatch",
                "unsupported_profile",
                "unsupported_policy",
                "incompatible_representation",
                "source_too_large",
                "request_too_large",
                "source_unavailable",
                "source_tombstoned",
                "source_revision_mismatch",
                "duplicate_list_id",
                "duplicate_retrieval_rank",
                "candidate_identity_conflict",
                "invalid_candidate",
                "invalid_node",
                "missing_endpoint_node",
                "traversal_limit_exceeded",
                "invalid_embedding_mode",
                "vector_dimension_mismatch",
                "tokenization_failed",
                "invalid_scope",
                "not_ready",
                "cutover_in_progress",
                "fence_expired",
                "fence_released",
                "invalid_fence",
                "operation_not_found",
                "dependency_unavailable",
                "service_unavailable",
                "deadline_exceeded",
                "context_assembly_failed",
                "internal_error",
                "reconciliation_required",
                "operation_failed",
                "sequence_regression"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "searchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "scope",
        "index_profile",
        "lexical_profile",
        "terms",
        "limit"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "query_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "index_profile": {
          "$ref": "#/$defs/profile"
        },
        "lexical_profile": {
          "$ref": "#/$defs/profile"
        },
        "terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 256,
          "minItems": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 8,
            "maxLength": 138,
            "pattern": "^(memory|knowledge):[A-Za-z0-9._~-]{1,128}$"
          },
          "maxItems": 100,
          "minItems": 0
        },
        "source_revisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 100,
          "minItems": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "page_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_revision",
        "revision_sequence",
        "chunk_id",
        "chunker",
        "text",
        "retrieval_rank",
        "score",
        "score_semantics",
        "provenance"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 138,
          "pattern": "^(memory|knowledge):[A-Za-z0-9._~-]{1,128}$"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "chunk_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "chunker": {
          "$ref": "#/$defs/chunker"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "retrieval_rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "score": {
          "type": "number"
        },
        "score_semantics": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "matched_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "maxItems": 256,
          "minItems": 0
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "searchResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "index_profile",
        "lexical_profile",
        "candidates",
        "truncated",
        "request_id"
      ],
      "properties": {
        "query_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "index_profile": {
          "$ref": "#/$defs/profile"
        },
        "lexical_profile": {
          "$ref": "#/$defs/profile"
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate"
          },
          "maxItems": 100,
          "minItems": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "next_page_token": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        }
      }
    },
    "sourceId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 138,
      "pattern": "^(memory|knowledge):[A-Za-z0-9._~-]{1,128}$"
    },
    "chunker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "version"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  },
  "x-endpoints": {
    "POST /api/v1/lexical-retrieval/search": {
      "request": "$defs/searchRequest",
      "response": "$defs/searchResponse",
      "success_status": 200,
      "error_response": "$defs/errorResponse"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/searchRequest"
    },
    {
      "$ref": "#/$defs/searchResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    }
  ]
}
