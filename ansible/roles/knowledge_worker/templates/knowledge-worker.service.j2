[Unit]
Description=Knowledge Queue Worker - Auto-ingests Claude Code sessions into knowledge store
Wants=redis.service
After=redis.service postgresql.service unified-api.service
StartLimitIntervalSec={{ knowledge_worker_start_limit_interval }}
StartLimitBurst={{ knowledge_worker_start_limit_burst }}

[Service]
Type=simple
User={{ knowledge_worker_user }}
WorkingDirectory={{ knowledge_worker_working_dir }}
ExecStart=/usr/bin/python3 workers/knowledge_worker.py --api-url {{ knowledge_worker_api_url }}
Restart=always
RestartSec={{ knowledge_worker_restart_sec }}
StandardOutput=append:{{ knowledge_worker_log }}
StandardError=append:{{ knowledge_worker_log }}

[Install]
WantedBy=multi-user.target
