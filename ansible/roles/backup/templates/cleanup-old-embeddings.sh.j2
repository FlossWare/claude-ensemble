#!/bin/bash
# Clean up embeddings older than 90 days from PostgreSQL
# Managed by Ansible - do not edit manually

set -euo pipefail

RETENTION_DAYS=90

echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting 90-day embedding cleanup..."

# Count embeddings to be removed
COUNT=$(psql -h localhost -p {{ db_port }} -U {{ db_user }} -d {{ db_name }} -t -A -c \
  "SELECT COUNT(*) FROM learning.experiences WHERE created_at < NOW() - INTERVAL '${RETENTION_DAYS} days' AND embedding IS NOT NULL AND metadata->>'retain' IS NULL;")

echo "[$(date '+%Y-%m-%d %H:%M:%S')] Found $COUNT embeddings older than ${RETENTION_DAYS} days to clean up"

if [ "$COUNT" -gt 0 ]; then
  # Null out old embeddings (keep the row, just remove the vector)
  psql -h localhost -p {{ db_port }} -U {{ db_user }} -d {{ db_name }} -c \
    "UPDATE learning.experiences SET embedding = NULL WHERE created_at < NOW() - INTERVAL '${RETENTION_DAYS} days' AND embedding IS NOT NULL AND metadata->>'retain' IS NULL;"

  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Cleaned up $COUNT old embeddings"
else
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] No old embeddings to clean up"
fi

# Vacuum the table to reclaim space
psql -h localhost -p {{ db_port }} -U {{ db_user }} -d {{ db_name }} -c \
  "VACUUM ANALYZE learning.experiences;"

echo "[$(date '+%Y-%m-%d %H:%M:%S')] Embedding cleanup complete"
