#!/bin/bash
# Automated PostgreSQL backup
# Managed by Ansible - do not edit manually

set -euo pipefail

TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_DIR="{{ backup_dir }}/learning"
RETENTION_DAYS={{ backup_retention_days }}

mkdir -p "$BACKUP_DIR"

echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting backup..."

# Dump database
pg_dump -h localhost -p {{ db_port }} -U {{ db_user }} -d {{ db_name }} \
  --format=custom \
  --compress=9 \
  -f "$BACKUP_DIR/learning_${TIMESTAMP}.dump"

# Cleanup old backups
find "$BACKUP_DIR" -name "learning_*.dump" -mtime +${RETENTION_DAYS} -delete

echo "[$(date '+%Y-%m-%d %H:%M:%S')] Backup complete: learning_${TIMESTAMP}.dump"
