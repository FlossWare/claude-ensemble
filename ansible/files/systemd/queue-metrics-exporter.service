[Unit]
Description=Redis Queue Metrics Prometheus Exporter
After=network.target redis-sentinel.service

[Service]
Type=simple
User=sfloess
WorkingDirectory=/home/sfloess/Development/redhat/scm/gitlab/cee/sfloess/claude-global-skills
ExecStart=/usr/bin/node /home/sfloess/Development/redhat/scm/gitlab/cee/sfloess/claude-global-skills/tools/queue-metrics-prometheus.js
Restart=always
RestartSec=10

# Environment
Environment="NODE_ENV=production"
Environment="METRICS_PORT=9091"

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=queue-metrics

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
