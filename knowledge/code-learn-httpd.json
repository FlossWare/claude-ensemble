  "request_processing_flow": {
    "stages": [
      {
        "phase": "Accept Connection",
        "files": [
          "connection.c",
          "os/unix/unixd.c"
        ],
        "description": "Accept incoming socket connection"
      },
      {
        "phase": "Read Request",
        "files": [
          "server/connection.c",
          "server/protocol.c"
        ],
        "description": "Read HTTP request line and headers"
      },
      {
        "phase": "Parse Request",
        "files": [
          "server/protocol.c"
        ],
        "description": "Parse HTTP method, URI, version, headers"
      },
      {
        "phase": "URL to Filename (translate_name hook)",
        "files": [
          "modules/mappers/*"
        ],
        "description": "Map URL to filesystem path"
      },
      {
        "phase": "Access Control (check_access hook)",
        "files": [
          "modules/aaa/*"
        ],
        "description": "Check IP-based access restrictions"
      },
      {
        "phase": "Authentication (check_user_id hook)",
        "files": [
          "modules/aaa/*"
        ],
        "description": "Authenticate user identity"
      },
      {
        "phase": "Authorization (authz hook)",
        "files": [
          "modules/aaa/*"
        ],
        "description": "Check user permissions"
      },
      {
        "phase": "Type Checking (type_checker hook)",
        "files": [
          "modules/generators/*"
        ],
        "description": "Determine content type"
      },
      {
        "phase": "Request Handler (handler hook)",
        "files": [
          "modules/*/",
          "server/"
        ],
        "description": "Generate response content"
      },
      {
        "phase": "Filter Chain",
        "files": [
          "server/util_filter.c",
          "modules/filters/*"
        ],
        "description": "Process response through filters (compression, substitution, etc.)"
      },
      {
        "phase": "Output",
        "files": [
          "server/protocol.c"
        ],
        "description": "Send response to client"
      },
      {
        "phase": "Logging (log_transaction hook)",
        "files": [
          "modules/loggers/*"
        ],
        "description": "Log request/response details"
      }
    ]
  },
