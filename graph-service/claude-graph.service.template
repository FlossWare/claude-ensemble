[Unit]
Description=Claude Ensemble Graph Service - Local Graph HTTP boundary
Documentation=file://%h/.config/systemd/user/claude-graph.service.d/README.md
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/env python3 %REPO_PATH%/graph-service/graph_service.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=claude-ensemble-graph-service

# Optional per-user portable configuration.
EnvironmentFile=-%h/.config/claude-ensemble/environment

# Environment
Environment="PATH=%h/.local/bin:%REPO_PATH%/tools:/usr/local/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="ENSEMBLE_GRAPH_HOST=127.0.0.1"
Environment="ENSEMBLE_GRAPH_PORT=8766"
Environment="ENSEMBLE_GRAPH_STORE=%h/.local/share/claude-ensemble/graph.json"

# Resource limits
MemoryLimit=256M
CPUQuota=25%

[Install]
WantedBy=default.target
