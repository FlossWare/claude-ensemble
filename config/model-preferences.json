{
  "$schema": "model-preferences-schema",
  "description": "User-configurable model preferences and overrides",

  "cost_preference": "balanced",
  "_cost_options": ["cheap", "balanced", "quality"],

  "global_rules": {
    "never_use": [],
    "_comment": "Models to NEVER use for any task (global blacklist)"
  },

  "task_overrides": {
    "_comment": "Override default rules for specific task types",
    "_example": {
      "code_review": {
        "whitelist": ["opus", "sonnet"],
        "blacklist": ["haiku"],
        "min_score": 0.8,
        "reason": "Custom preference for code review"
      }
    }
  },

  "redhat_compliance": {
    "enabled": true,
    "enforce_anthropic_only": true,
    "_comment": "Red Hat work MUST use Anthropic models only (compliance requirement)",
    "_affected_tasks": [
      "redhat_code_review",
      "redhat_security_audit",
      "redhat_architecture_review",
      "redhat_bug_detection"
    ]
  },

  "model_aliases": {
    "_comment": "Aliases for easier configuration",
    "anthropic": ["opus", "sonnet", "haiku", "fable"],
    "coding_specialists": ["deepseek-coder", "qwen-coder"],
    "cheap": ["haiku", "fable", "gemini-flash", "gpt-3.5"],
    "expensive": ["opus", "gpt-4o", "gemini-pro"]
  }
}
