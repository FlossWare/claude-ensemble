{
  "_comment": "Multi-AI consensus configuration - FLEET-AWARE with server topology. Quality over cost.",

  "enabled": true,

  "fleet": {
    "enabled": true,
    "dispatcher": "http://pi-02:3002",
    "loadBalance": true,
    "autoDistribute": true,
    "_comment": "Fleet-aware mode: automatically distribute AI calls across servers based on capabilities"
  },

  "default_strategy": "maximum-coverage",

  "workers": {
    "models": [
      {"name": "fable", "server": "laptop-01", "role": "heavy"},
      {"name": "opus", "server": "laptop-01", "role": "heavy"},
      {"name": "sonnet", "server": "server-01", "role": "fast"},
      {"name": "haiku", "server": "server-01", "role": "fast"},
      {"name": "gpt-4o", "server": "server-02", "role": "code"},
      {"name": "gemini", "server": "server-03", "role": "heavy"},
      {"name": "cerebras-120b", "server": "server-03", "role": "heavy", "api": "cerebras"},
      {"name": "qwen-coder-32b", "server": "server-02", "role": "code", "api": "cloudflare"},
      {"name": "llama-70b-fast", "server": "server-01", "role": "fast", "api": "cloudflare"}
