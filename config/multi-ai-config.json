    "aio-01": {
      "ram": 8,
      "cpu": 2,
      "roles": ["passive", "storage"],
      "services": ["prometheus", "nfs", "status-api"],
      "models": [],
      "priority": 5,
      "_comment": "Passive server - no AI execution, only storage/metrics"
    },
    "pi-02": {
      "ram": 1,
      "cpu": 4,
      "roles": ["coordinator", "dispatcher"],
      "services": ["job-queue", "health-monitor", "log-collector"],
      "models": [],
      "priority": 6,
      "_comment": "Active coordinator - dispatches work, does not execute AI"
    }
  },

  "presets": {
