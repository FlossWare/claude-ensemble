  },

  "serverCapabilities": {
    "laptop-01": {
      "ram": 31,
      "cpu": 4,
      "roles": ["heavy", "data", "arbiter"],
      "services": ["chromadb"],
      "models": ["fable", "opus"],
      "priority": 1
    },
    "server-01": {
      "ram": 15,
      "cpu": 8,
      "roles": ["fast", "preprocessing"],
      "models": ["sonnet", "haiku", "llama-70b-fast"],
      "priority": 2
    },
    "server-02": {
      "ram": 23,
      "cpu": 8,
      "roles": ["code", "medium"],
      "models": ["gpt-4o", "qwen-coder-32b"],
      "priority": 3
    },
    "server-03": {
      "ram": 31,
      "cpu": 8,
      "roles": ["heavy", "batch"],
      "models": ["gemini", "cerebras-120b", "nemotron-550b"],
      "priority": 4
