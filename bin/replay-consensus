#!/usr/bin/env node

/**
 * Consensus Replay CLI
 *
 * Wrapper around consensus-replay.cjs for easy replay of historical workflows.
 *
 * Usage:
 *   replay-consensus <workflow-id> [options]
 *   replay-consensus --list [--limit N]
 *   replay-consensus --latest
 *
 * Examples:
 *   # Replay specific workflow
 *   replay-consensus orchestrator-1782851258 --html-report /tmp/replay.html
 *
 *   # List available workflows
 *   replay-consensus --list --limit 20
 *
 *   # Replay latest successful workflow
 *   replay-consensus --latest --store
 *
 *   # Batch replay all workflows from last week
 *   replay-consensus --batch-recent --days 7 --store
 */

const path = require('path');
const { ConsensusReplay } = require('../shared/consensus-replay.cjs');

async function listWorkflows(limit = 10) {
  const replay = new ConsensusReplay();
  try {
    const result = await replay.pool.query(
      `SELECT workflow_id, workflow_name, task_description, outcome, created_at,
              total_workers, total_duration_ms
       FROM workflow.executions
       ORDER BY created_at DESC
       LIMIT $1`,
      [limit]
    );

    console.log('\nAvailable Workflows:\n');
    console.log('ID'.padEnd(30), 'Name'.padEnd(20), 'Outcome'.padEnd(10), 'Workers', 'Created');
    console.log('-'.repeat(100));

    for (const row of result.rows) {
      console.log(
        row.workflow_id.padEnd(30),
        row.workflow_name.padEnd(20),
        row.outcome.padEnd(10),
        String(row.total_workers || 0).padEnd(7),
        new Date(row.created_at).toLocaleString()
      );
    }

    console.log('\nTotal:', result.rows.length);
    console.log('\nReplay with: replay-consensus <workflow-id> [options]');

    await replay.close();
  } catch (error) {
    console.error('Error listing workflows:', error.message);
    await replay.close();
    process.exit(1);
  }
}

async function getLatestSuccessfulWorkflow() {
  const replay = new ConsensusReplay();
  try {
    const result = await replay.pool.query(
      `SELECT workflow_id
       FROM workflow.executions
       WHERE outcome = 'success' AND total_workers > 0
       ORDER BY created_at DESC
       LIMIT 1`
    );

    if (result.rows.length === 0) {
      console.error('No successful workflows found');
      await replay.close();
      process.exit(1);
    }

    const workflowId = result.rows[0].workflow_id;
    await replay.close();
    return workflowId;
  } catch (error) {
    console.error('Error finding latest workflow:', error.message);
    await replay.close();
    process.exit(1);
  }
}

async function batchReplayRecent(days = 7, store = false) {
  const replay = new ConsensusReplay();
  try {
    const result = await replay.pool.query(
      `SELECT workflow_id
       FROM workflow.executions
       WHERE created_at > NOW() - INTERVAL '${days} days'
         AND outcome = 'success'
         AND total_workers > 0
       ORDER BY created_at DESC`
    );

    console.log(`\nFound ${result.rows.length} workflows from last ${days} days`);

    for (let i = 0; i < result.rows.length; i++) {
      const workflowId = result.rows[i].workflow_id;
      console.log(`\n[${i + 1}/${result.rows.length}] Replaying ${workflowId}...`);

      try {
        const historical = await replay.fetchHistoricalWorkflow(workflowId);
        if (!historical) {
          console.log(`  Skipped: workflow data not found`);
          continue;
        }

        const newRun = await replay.rerunConsensus(historical, { sameModels: true });
        const comparison = replay.compareResults(historical, newRun);

        console.log(`  Verdict: ${comparison.summary.verdict}`);
        console.log(`  Avg Confidence Delta: ${comparison.summary.avg_confidence_delta}`);

        if (store) {
          await replay.storeReplayResults(comparison);
          console.log(`  Stored to database`);
        }

      } catch (error) {
        console.error(`  Error replaying ${workflowId}:`, error.message);
      }
    }

    await replay.close();
  } catch (error) {
    console.error('Batch replay failed:', error.message);
    await replay.close();
    process.exit(1);
  }
}

async function replayWorkflow(workflowId, options) {
  const replay = new ConsensusReplay();

  try {
    console.log(`Fetching historical workflow: ${workflowId}`);
    const historical = await replay.fetchHistoricalWorkflow(workflowId);

    if (!historical) {
      console.error(`Workflow not found: ${workflowId}`);
      process.exit(1);
    }

    console.log(`Found workflow from ${historical.execution.created_at}`);
    console.log(`Task: ${historical.execution.task_description.substring(0, 100)}...`);
    console.log(`Workers: ${historical.workers.length}`);

    console.log('\nRe-running consensus with current models...');
    const newRun = await replay.rerunConsensus(historical, {
      sameModels: options.sameModels,
      overrideModels: options.overrideModels
    });

    console.log('\nComparing results...');
    const comparison = replay.compareResults(historical, newRun);

    console.log('\n=== COMPARISON SUMMARY ===');
    console.log(`Verdict: ${comparison.summary.verdict}`);
    console.log(`Avg Confidence Delta: ${comparison.summary.avg_confidence_delta}`);
    console.log(`Arbiter Confidence Delta: ${comparison.summary.arbiter_confidence_delta}`);
    console.log(`Total Cost Delta: $${comparison.summary.total_cost_delta}`);

    console.log('\n=== WORKER DELTAS ===');
    for (const w of comparison.workers) {
      console.log(
        `${w.model.padEnd(15)} Confidence: ${w.confidence_delta.toFixed(3).padStart(6)}  ` +
        `Speed: ${w.speed_improvement.padStart(8)}  Cost: $${w.cost_delta.toFixed(4)}`
      );
    }

    if (options.store) {
      console.log('\nStoring replay results to database...');
      const replayId = await replay.storeReplayResults(comparison);
      console.log(`Stored as replay ID: ${replayId}`);
    }

    if (options.htmlReport) {
      console.log('\nGenerating HTML report...');
      replay.generateHTMLReport(comparison, options.htmlReport);
      console.log(`HTML report: ${options.htmlReport}`);
    }

    await replay.close();

  } catch (error) {
    console.error('Replay failed:', error);
    await replay.close();
    process.exit(1);
  }
}

// Parse CLI arguments
async function main() {
  const args = process.argv.slice(2);

  if (args.length === 0 || args.includes('--help') || args.includes('-h')) {
    console.log(`
Consensus Replay CLI

Usage:
  replay-consensus <workflow-id> [options]    Replay a specific workflow
  replay-consensus --list [--limit N]         List available workflows
  replay-consensus --latest [options]         Replay latest successful workflow
  replay-consensus --batch-recent [options]   Replay all recent workflows

Options:
  --same-models             Use same models as original (default)
  --override-models M1,M2   Use specific models instead
  --html-report PATH        Generate HTML report
  --store                   Store replay results to database
  --limit N                 Limit for --list (default: 10)
  --days N                  Days for --batch-recent (default: 7)

Examples:
  # List recent workflows
  replay-consensus --list --limit 20

  # Replay specific workflow with HTML report
  replay-consensus orchestrator-1782851258 --html-report /tmp/replay.html --store

  # Replay latest successful workflow
  replay-consensus --latest --store

  # Batch replay all workflows from last 3 days
  replay-consensus --batch-recent --days 3 --store
`);
    process.exit(0);
  }

  // Handle --list
  if (args.includes('--list')) {
    const limit = args.includes('--limit')
      ? parseInt(args[args.indexOf('--limit') + 1])
      : 10;
    await listWorkflows(limit);
    return;
  }

  // Handle --batch-recent
  if (args.includes('--batch-recent')) {
    const days = args.includes('--days')
      ? parseInt(args[args.indexOf('--days') + 1])
      : 7;
    const store = args.includes('--store');
    await batchReplayRecent(days, store);
    return;
  }

  // Handle --latest
  let workflowId;
  if (args.includes('--latest')) {
    workflowId = await getLatestSuccessfulWorkflow();
    console.log(`Latest successful workflow: ${workflowId}\n`);
  } else {
    workflowId = args[0];
  }

  if (!workflowId) {
    console.error('Error: No workflow ID provided');
    process.exit(1);
  }

  // Parse options
  const options = {
    sameModels: !args.includes('--override-models'),
    overrideModels: args.includes('--override-models')
      ? args[args.indexOf('--override-models') + 1].split(',')
      : null,
    htmlReport: args.includes('--html-report')
      ? args[args.indexOf('--html-report') + 1]
      : null,
    store: args.includes('--store')
  };

  await replayWorkflow(workflowId, options);
}

main().catch(err => {
  console.error('Fatal error:', err);
  process.exit(1);
});
