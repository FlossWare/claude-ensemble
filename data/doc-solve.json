{
  "name": "doc-solve",
  "description": "Autonomous documentation issue resolution",
  "entrypoint": "./doc-solve.sh",
  "completions": {
    "arguments": [
      {
        "name": "issue_number",
        "type": "number",
        "required": false,
        "suggestions": ["loop"]
      }
    ],
    "options": [
      {
        "name": "--consensus",
        "type": "enum",
        "values": ["rotating", "single", "majority", "pairwise", "weighted"],
        "default": "rotating"
      },
      {
        "name": "--execution",
        "type": "enum",
        "values": ["parallel", "sequential", "batched", "cascade", "weighted-parallel"],
        "default": "parallel"
      },
      {
        "name": "--workers",
        "type": "number",
        "values": [2, 3, 4, 6, 8, 10],
        "default": 6
      }
    ]
  }
}
