[Unit]
Description=Auto Storage Worker 3 (aio-01)
After=network.target

[Service]
Type=simple
User=sfloess
WorkingDirectory=/tmp
ExecStart=/usr/bin/python3 /tmp/auto_storage_system.py --worker-id 3 --total-workers 5
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
