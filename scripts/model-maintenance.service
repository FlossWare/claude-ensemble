[Unit]
Description=API Model Maintenance
Documentation=file:///mnt/aio-01/claude-orchestrator/scripts/maintain-models.py

[Service]
Type=oneshot
User=root
WorkingDirectory=/mnt/aio-01/claude-orchestrator/scripts

# Load API keys from proxy env
EnvironmentFile=/etc/default/api-proxy

ExecStart=/usr/bin/python3 /mnt/aio-01/claude-orchestrator/scripts/maintain-models.py --auto

# Log output
StandardOutput=journal
StandardError=journal
SyslogIdentifier=model-maintenance
