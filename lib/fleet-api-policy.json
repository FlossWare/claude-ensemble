{
  "version": "1.0",
  "updated": "2026-06-18",
  "description": "Fleet node API access policy - defines which nodes can use paid APIs",

  "nodes": {
    "laptop-01": {
      "local_models": true,
      "free_apis": true,
      "paid_apis": true,
      "role": "primary",
      "notes": "Main orchestrator node with full API access"
    },
    "aio-01": {
      "local_models": true,
      "free_apis": true,
      "paid_apis": false,
      "role": "worker",
      "notes": "Worker node - local Ollama + free APIs only"
    },
    "server-01": {
      "local_models": true,
      "free_apis": true,
      "paid_apis": false,
      "role": "worker",
      "notes": "Worker node - local Ollama + free APIs only"
    },
    "server-02": {
      "local_models": true,
      "free_apis": true,
      "paid_apis": false,
      "role": "worker",
      "notes": "Worker node - local Ollama + free APIs only"
    },
    "server-03": {
      "local_models": true,
      "free_apis": true,
      "paid_apis": false,
      "role": "worker",
      "notes": "Worker node - local Ollama + free APIs only"
    }
  },

  "free_apis": [
    {
      "provider": "groq",
      "models": ["llama-3.3-70b-versatile", "llama-3.1-8b-instant", "mixtral-8x7b-32768"],
      "rate_limit": "30 requests/min",
      "notes": "Fast inference, good for quick tasks"
    },
    {
      "provider": "deepinfra",
      "models": ["meta-llama/Meta-Llama-3.1-70B-Instruct", "mistralai/Mixtral-8x22B-Instruct-v0.1"],
      "rate_limit": "varies",
      "notes": "Wide model selection"
    },
    {
      "provider": "together",
      "models": ["meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo", "mistralai/Mixtral-8x22B-Instruct-v0.1"],
      "rate_limit": "varies",
      "notes": "Open models"
    },
    {
      "provider": "huggingface",
      "models": ["meta-llama/Meta-Llama-3-70B-Instruct", "mistralai/Mixtral-8x7B-Instruct-v0.1"],
      "rate_limit": "varies",
      "notes": "Inference API free tier"
    },
    {
      "provider": "fireworks",
      "models": ["accounts/fireworks/models/llama-v3p1-70b-instruct"],
      "rate_limit": "varies",
      "notes": "Free tier available"
    },
    {
      "provider": "replicate",
      "models": ["meta/meta-llama-3-70b-instruct"],
      "rate_limit": "free tier",
      "notes": "Pay-per-use but has free tier"
    },
    {
      "provider": "perplexity",
      "models": ["llama-3.1-sonar-large-128k-online"],
      "rate_limit": "5 requests/hour free",
      "notes": "Online search + LLM"
    },
    {
      "provider": "cohere",
      "models": ["command-r-plus"],
      "rate_limit": "trial tier",
      "notes": "Free trial available"
    },
    {
      "provider": "ai21",
      "models": ["jamba-1.5-large", "jamba-1.5-mini"],
      "rate_limit": "free tier",
      "notes": "Hybrid SSM + Transformer"
    },
    {
      "provider": "mistral",
      "models": ["mistral-large-latest", "mistral-small-latest"],
      "rate_limit": "free tier",
      "notes": "Mistral AI free tier"
    }
  ],

  "paid_apis": [
    {
      "provider": "anthropic",
      "models": ["claude-opus-4", "claude-sonnet-4.5", "claude-haiku-4"],
      "allowed_nodes": ["laptop-01"],
      "notes": "Only laptop-01 can use Anthropic APIs"
    },
    {
      "provider": "openai",
      "models": ["gpt-4o", "gpt-4-turbo", "gpt-3.5-turbo"],
      "allowed_nodes": ["laptop-01"],
      "notes": "Only laptop-01 can use OpenAI APIs"
    },
    {
      "provider": "google",
      "models": ["gemini-2.0-flash-exp", "gemini-1.5-pro"],
      "allowed_nodes": ["laptop-01"],
      "notes": "Only laptop-01 can use Google APIs (if paid tier)"
    }
  ],

  "local_models": {
    "ollama": {
      "models": [
        "deepseek-coder-v2-lite",
        "phi-4-mini",
        "mistral-7b-instruct",
        "llama-3.1-8b",
        "qwen-2.5-7b",
        "gemma-2-9b"
      ],
      "notes": "Available on all fleet nodes"
    }
  },

  "enforcement": {
    "method": "pre-flight-check",
    "description": "Before routing task to node, check if requested model is allowed on that node",
    "fallback": "If paid API requested on worker node, route to laptop-01 or use free alternative"
  }
}
