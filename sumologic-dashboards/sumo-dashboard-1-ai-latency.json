{
  "type": "DashboardV2SyncDefinition",
  "name": "AI Service Latency & Performance",
  "description": "Monitor AI service latency (p50/p95/p99), throughput, and performance metrics",
  "title": "AI Service Latency & Performance",
  "theme": "Dark",
  "topologyLabelMap": {
    "data": {}
  },
  "refreshInterval": 300000,
  "timeRange": {
    "type": "BeginBoundedTimeRange",
    "from": {
      "type": "RelativeTimeRangeBoundary",
      "relativeTime": "-1h"
    }
  },
  "layout": {
    "layoutType": "Grid",
    "layoutStructures": [
      {
        "key": "panelPANE-0001",
        "structure": "{\"height\":8,\"width\":12,\"x\":0,\"y\":0}"
      },
      {
        "key": "panelPANE-0002",
        "structure": "{\"height\":8,\"width\":12,\"x\":12,\"y\":0}"
      },
      {
        "key": "panelPANE-0003",
        "structure": "{\"height\":8,\"width\":12,\"x\":0,\"y\":8}"
      },
      {
        "key": "panelPANE-0004",
        "structure": "{\"height\":8,\"width\":12,\"x\":12,\"y\":8}"
      }
    ]
  },
  "panels": [
    {
      "id": null,
      "key": "panelPANE-0001",
      "title": "AI Service Latency (p50/p95/p99)",
      "visualSettings": "{\"general\":{\"mode\":\"timeSeries\",\"type\":\"line\",\"displayType\":\"default\",\"markerSize\":5,\"lineDashType\":\"solid\",\"markerType\":\"none\"},\"color\":{\"family\":\"scheme9\"},\"overrides\":[]}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "queryString": "_sourceCategory=disseminator_ai\n| parse \"latency_ms=*\" as latency\n| parse \"service=*\" as service\n| timeslice 5m\n| pct(latency, 50, 95, 99) as (p50, p95, p99) by _timeslice, service",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
          "parseMode": "Auto",
          "timeSource": "Message"
        }
      ],
      "description": "",
      "timeRange": null,
      "coloringRules": null,
      "linkedDashboards": []
    },
    {
      "id": null,
      "key": "panelPANE-0002",
      "title": "AI Service Throughput (queries/min)",
      "visualSettings": "{\"general\":{\"mode\":\"timeSeries\",\"type\":\"area\",\"displayType\":\"stacked\",\"markerSize\":5,\"lineDashType\":\"solid\"},\"color\":{\"family\":\"scheme9\"},\"overrides\":[]}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "queryString": "_sourceCategory=disseminator_ai\n| parse \"service=*\" as service\n| parse \"endpoint=*\" as endpoint\n| timeslice 1m\n| count by _timeslice, service, endpoint",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
          "parseMode": "Auto",
          "timeSource": "Message"
        }
      ],
      "description": "",
      "timeRange": null,
      "coloringRules": null,
      "linkedDashboards": []
    },
    {
      "id": null,
      "key": "panelPANE-0003",
      "title": "Top 10 Slowest Queries",
      "visualSettings": "{\"general\":{\"mode\":\"distribution\",\"type\":\"table\"},\"series\":{}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "queryString": "_sourceCategory=disseminator_ai\n| parse \"latency_ms=*\" as latency\n| parse \"query=*\" as query\n| parse \"service=*\" as service\n| topk(10, latency)",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
          "parseMode": "Auto",
          "timeSource": "Message"
        }
      ],
      "description": "",
      "timeRange": null,
      "coloringRules": null,
      "linkedDashboards": []
    },
    {
      "id": null,
      "key": "panelPANE-0004",
      "title": "Average Latency by Service",
      "visualSettings": "{\"general\":{\"mode\":\"distribution\",\"type\":\"bar\"},\"series\":{}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "queryString": "_sourceCategory=disseminator_ai\n| parse \"latency_ms=*\" as latency\n| parse \"service=*\" as service\n| avg(latency) by service\n| sort by _avg",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
