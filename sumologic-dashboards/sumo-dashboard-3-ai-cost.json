{
  "type": "DashboardV2SyncDefinition",
  "name": "AI Cost Tracking & Budget",
  "description": "Monitor AI service costs, budget tracking, and cost optimization opportunities",
  "title": "AI Cost Tracking & Budget",
  "theme": "Dark",
  "topologyLabelMap": {
    "data": {}
  },
  "refreshInterval": 3600000,
  "timeRange": {
    "type": "BeginBoundedTimeRange",
    "from": {
      "type": "RelativeTimeRangeBoundary",
      "relativeTime": "-7d"
    }
  },
  "layout": {
    "layoutType": "Grid",
    "layoutStructures": [
      {
        "key": "panelPANE-0001",
        "structure": "{\"height\":6,\"width\":8,\"x\":0,\"y\":0}"
      },
      {
        "key": "panelPANE-0002",
        "structure": "{\"height\":6,\"width\":8,\"x\":8,\"y\":0}"
      },
      {
        "key": "panelPANE-0003",
        "structure": "{\"height\":6,\"width\":8,\"x\":16,\"y\":0}"
      },
      {
        "key": "panelPANE-0004",
        "structure": "{\"height\":8,\"width\":12,\"x\":0,\"y\":6}"
      },
      {
        "key": "panelPANE-0005",
        "structure": "{\"height\":8,\"width\":12,\"x\":12,\"y\":6}"
      }
    ]
  },
  "panels": [
    {
      "id": null,
      "key": "panelPANE-0001",
      "title": "Cost Today",
      "visualSettings": "{\"general\":{\"mode\":\"singleValueMetrics\",\"type\":\"svp\"},\"svp\":{\"option\":\"Latest\",\"label\":\"USD\",\"useBackgroundColor\":false,\"rounding\":2,\"valueFontSize\":24,\"labelFontSize\":14,\"thresholds\":[{\"from\":null,\"to\":50,\"color\":\"#16943E\"},{\"from\":50,\"to\":100,\"color\":\"#DFBE2E\"},{\"from\":100,\"to\":null,\"color\":\"#BF2121\"}]}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "queryString": "_sourceCategory=disseminator_ai\n| parse \"cost_usd=*\" as cost\n| where _messagetime >= now() - 1d\n| sum(cost) as total_cost\n| fields total_cost",
          "queryType": "Logs",
          "queryKey": "A"
        }
      ],
      "description": "",
      "timeRange": null,
      "coloringRules": null,
      "linkedDashboards": []
    },
    {
      "id": null,
      "key": "panelPANE-0002",
      "title": "Cost This Week",
      "visualSettings": "{\"general\":{\"mode\":\"singleValueMetrics\",\"type\":\"svp\"},\"svp\":{\"option\":\"Latest\",\"label\":\"USD\",\"useBackgroundColor\":false,\"rounding\":2,\"valueFontSize\":24,\"labelFontSize\":14}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "queryString": "_sourceCategory=disseminator_ai\n| parse \"cost_usd=*\" as cost\n| where _messagetime >= now() - 7d\n| sum(cost) as total_cost\n| fields total_cost",
          "queryType": "Logs",
          "queryKey": "A"
        }
      ],
      "description": "",
      "timeRange": null,
      "coloringRules": null,
      "linkedDashboards": []
    },
    {
      "id": null,
      "key": "panelPANE-0003",
      "title": "Projected Monthly Cost",
      "visualSettings": "{\"general\":{\"mode\":\"singleValueMetrics\",\"type\":\"svp\"},\"svp\":{\"option\":\"Latest\",\"label\":\"USD/month\",\"useBackgroundColor\":false,\"rounding\":2,\"valueFontSize\":24,\"labelFontSize\":14,\"thresholds\":[{\"from\":null,\"to\":500,\"color\":\"#16943E\"},{\"from\":500,\"to\":1000,\"color\":\"#DFBE2E\"},{\"from\":1000,\"to\":null,\"color\":\"#BF2121\"}]}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "queryString": "_sourceCategory=disseminator_ai\n| parse \"cost_usd=*\" as cost\n| where _messagetime >= now() - 7d\n| sum(cost) as weekly_cost\n| (weekly_cost / 7) * 30 as monthly_projection\n| fields monthly_projection",
          "queryType": "Logs",
          "queryKey": "A"
        }
      ],
      "description": "Based on 7-day average",
      "timeRange": null,
      "coloringRules": null,
      "linkedDashboards": []
    },
    {
      "id": null,
      "key": "panelPANE-0004",
      "title": "Daily Cost Trend",
      "visualSettings": "{\"general\":{\"mode\":\"timeSeries\",\"type\":\"area\",\"displayType\":\"stacked\"},\"color\":{\"family\":\"scheme9\"}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "queryString": "_sourceCategory=disseminator_ai\n| parse \"cost_usd=*\" as cost\n| parse \"service=*\" as service\n| timeslice 1d\n| sum(cost) as daily_cost by _timeslice, service",
          "queryType": "Logs",
          "queryKey": "A"
        }
      ],
      "description": "",
      "timeRange": null,
      "coloringRules": null,
      "linkedDashboards": []
    },
    {
      "id": null,
      "key": "panelPANE-0005",
      "title": "Cost by Service (Last 7 Days)",
      "visualSettings": "{\"general\":{\"mode\":\"distribution\",\"type\":\"pie\"},\"color\":{\"family\":\"scheme9\"}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "queryString": "_sourceCategory=disseminator_ai\n| parse \"cost_usd=*\" as cost\n| parse \"service=*\" as service\n| sum(cost) as total_cost by service\n| sort by total_cost desc",
          "queryType": "Logs",
          "queryKey": "A"
        }
      ],
      "description": "",
      "timeRange": null,
      "coloringRules": null,
      "linkedDashboards": []
    }
  ],
  "variables": [],
  "coloringRules": []
}
