[Unit]
Description=Admin REST API
Documentation=file:///opt/admin-api.py
After=network.target postgresql.service api-proxy.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt

# Run with Python
ExecStart=/usr/bin/python3 /opt/admin-api.py

# Restart on failure
Restart=on-failure
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=admin-api

[Install]
WantedBy=multi-user.target
