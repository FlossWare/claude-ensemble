[Unit]
Description=Fleet Health Monitor - Periodic Node Health Checks
Documentation=https://github.com/your-repo/claude-global-skills
After=fleet-brain-api.service
Requires=fleet-brain-api.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/fleet-brain
Environment="NODE_ENV=production"
ExecStart=/usr/bin/node /home/pi/fleet-brain/fleet-node-monitor.cjs monitor
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fleet-health-monitor

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/pi/fleet-brain

# Resource limits
MemoryMax=128M
CPUQuota=25%

[Install]
WantedBy=multi-user.target
