[Unit]
Description=Fleet Brain API Server - Orchestration Hub for Distributed Models
Documentation=https://github.com/your-repo/claude-global-skills
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/fleet-brain
Environment="NODE_ENV=production"
Environment="PORT=8080"
Environment="REGISTRY_PATH=/home/pi/fleet-brain/fleet-model-registry.json"
ExecStart=/usr/bin/node /home/pi/fleet-brain/pi02-orchestrator-api.cjs
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fleet-brain-api

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/pi/fleet-brain

# Resource limits (pi-02 has 1GB RAM)
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
