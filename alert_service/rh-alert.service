[Unit]
Description=RH Alert Service - Central alert service for Claude Code monitoring
Documentation=file://%h/.config/systemd/user/rh-alert.service.d/README.md
After=network.target rh-learning.service
Wants=rh-learning.service

[Service]
Type=simple
ExecStart=/home/sfloess/Development/redhat/scm/gitlab/cee/sfloess/claude-global-skills/alert_service/alert_service.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rh-alert-service

# Environment
Environment="PATH=/home/sfloess/.local/bin:/home/sfloess/Development/redhat/scm/gitlab/cee/sfloess/claude-global-skills/tools:/home/sfloess/Development/redhat/scm/gitlab/cee/sfloess/claude-global-skills:/usr/local/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="RH_REPO_ROOT=/home/sfloess/Development/redhat/scm/gitlab/cee/sfloess/claude-global-skills"

# Resource limits
MemoryLimit=256M
CPUQuota=25%

[Install]
WantedBy=default.target
