{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Synthesized Findings Schema",
  "description": "Schema for synthesized findings combining extracted claims with verification results",
  "type": "object",
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "description": "Array of synthesized findings with cross-referenced sources",
      "items": {
        "type": "object",
        "required": ["id", "claim", "confidence", "verified"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the finding",
            "pattern": "^finding_[0-9]{3,}$"
          },
          "claim": {
            "type": "string",
            "description": "The synthesized finding statement",
            "minLength": 10,
            "maxLength": 1000
          },
          "original_claim_id": {
            "type": "string",
            "description": "Reference to the original extracted claim",
            "pattern": "^claim_[0-9]{3,}$"
          },
          "confidence": {
            "type": "number",
            "description": "Overall confidence in this finding (0.0-1.0)",
            "minimum": 0,
            "maximum": 1
          },
          "verified": {
            "type": "boolean",
            "description": "Whether the finding has been verified through evidence"
          },
          "verification_status": {
            "type": "string",
            "description": "Detailed verification status",
            "enum": [
              "fully_verified",
              "partially_verified",
              "unverified",
              "contradicted",
              "unsupported"
            ]
          },
          "sources": {
            "type": "array",
            "description": "Sources supporting this finding",
            "items": {
              "type": "object",
              "required": ["url", "title"],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "Source URL"
                },
                "title": {
                  "type": "string",
                  "description": "Source title or publication",
                  "minLength": 5,
                  "maxLength": 300
                },
                "author": {
                  "type": "string",
                  "description": "Source author(s)"
                },
                "publication_date": {
                  "type": "string",
                  "format": "date",
                  "description": "Date of publication"
                },
                "source_type": {
                  "type": "string",
                  "description": "Category of source",
                  "enum": [
                    "academic_paper",
                    "news_article",
                    "government_report",
                    "official_statement",
                    "fact_check",
                    "research_database",
                    "book",
                    "website"
                  ]
                },
                "credibility_score": {
                  "type": "number",
                  "description": "Estimated credibility of the source (0.0-1.0)",
                  "minimum": 0,
                  "maximum": 1
                },
                "quote": {
                  "type": "string",
                  "description": "Relevant excerpt from the source",
                  "maxLength": 500
                },
                "relevance_to_claim": {
                  "type": "number",
                  "description": "How relevant this source is to the claim (0.0-1.0)",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "additionalProperties": false
            },
            "minItems": 0
          },
          "contradicting_sources": {
            "type": "array",
            "description": "Sources that contradict or question this finding",
            "items": {
              "type": "object",
              "required": ["url", "title"],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "title": {
                  "type": "string"
                },
                "contradiction_summary": {
                  "type": "string",
                  "description": "How this source contradicts the finding",
                  "maxLength": 300
                }
              },
              "additionalProperties": false
            },
            "minItems": 0
          },
          "synthesis_notes": {
            "type": "string",
            "description": "Notes on how this finding was synthesized from multiple sources",
            "maxLength": 1000
          },
          "limitations": {
            "type": "array",
            "description": "Known limitations or caveats to this finding",
            "items": {
              "type": "string",
              "minLength": 10,
              "maxLength": 300
            },
            "maxItems": 5
          },
          "category": {
            "type": "string",
            "description": "Subject category of the finding",
            "enum": [
              "statistical",
              "historical",
              "scientific",
              "legal",
              "biographical",
              "technical",
              "economic",
              "medical",
              "other"
            ]
          },
          "importance_score": {
            "type": "number",
            "description": "Importance of this finding to the overall topic (0.0-1.0)",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "synthesis_metadata": {
      "type": "object",
      "description": "Metadata about the synthesis process",
      "properties": {
        "synthesis_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When synthesis occurred"
        },
        "synthesis_models": {
          "type": "array",
          "description": "AI models used in synthesis",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "total_unique_sources": {
          "type": "integer",
          "description": "Number of unique sources referenced",
          "minimum": 0
        },
        "findings_with_consensus": {
          "type": "integer",
          "description": "Number of findings with source consensus",
          "minimum": 0
        },
        "findings_with_contradictions": {
          "type": "integer",
          "description": "Number of findings with contradicting sources",
          "minimum": 0
        }
      }
    }
  },
  "additionalProperties": false
}
