{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Validation Rules and Cross-Schema Constraints",
  "description": "Additional validation rules and constraints that apply across all ai-pdf-deep-research schemas",
  "definitions": {
    "confidence_metric": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence score on 0-1 scale"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^claim_[0-9]{3,}$",
      "description": "Extracted claim identifier"
    },
    "finding_id": {
      "type": "string",
      "pattern": "^finding_[0-9]{3,}$",
      "description": "Synthesized finding identifier"
    },
    "verified_claim_id": {
      "type": "string",
      "pattern": "^verified_[0-9]{3,}$",
      "description": "Verified claim in final report"
    },
    "source_id": {
      "type": "string",
      "pattern": "^src_[0-9]{3,}$",
      "description": "Source bibliography identifier"
    },
    "report_id": {
      "type": "string",
      "pattern": "^report_[a-z0-9_-]{8,}$",
      "description": "Final report identifier"
    },
    "iso_datetime": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 datetime stamp"
    },
    "iso_date": {
      "type": "string",
      "format": "date",
      "description": "ISO 8601 date (YYYY-MM-DD)"
    },
    "uri": {
      "type": "string",
      "format": "uri",
      "description": "Valid URI/URL"
    },
    "claim_text": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000,
      "description": "Claim statement text"
    },
    "short_text": {
      "type": "string",
      "minLength": 5,
      "maxLength": 300,
      "description": "Short text field"
    },
    "medium_text": {
      "type": "string",
      "minLength": 20,
      "maxLength": 500,
      "description": "Medium length text field"
    },
    "long_text": {
      "type": "string",
      "minLength": 50,
      "maxLength": 2000,
      "description": "Long form text field"
    }
  },
  "validation_constraints": {
    "cross_schema_requirements": [
      {
        "constraint": "claim_id_continuity",
        "description": "All claim IDs must be numerically sequential starting from claim_001",
        "applies_to": ["extracted-claims"]
      },
      {
        "constraint": "claim_id_reference_integrity",
        "description": "Every verdicts[].claim_id must reference an existing claim from extracted-claims",
        "applies_to": ["adversarial-verdict"],
        "references": "extracted-claims.claims[].id"
      },
      {
        "constraint": "finding_id_continuity",
        "description": "All finding IDs must be numerically sequential starting from finding_001",
        "applies_to": ["synthesized-findings"]
      },
      {
        "constraint": "verdict_completion",
        "description": "Every claim must have a corresponding verdict",
        "applies_to": ["adversarial-verdict"],
        "ratio": "1:1"
      },
      {
        "constraint": "source_url_uniqueness",
        "description": "No duplicate source URLs across adversarial-verdict and final-report",
        "applies_to": ["adversarial-verdict", "final-report"]
      },
      {
        "constraint": "verified_claim_independence",
        "description": "Each verified claim in final report must derive from at least one synthesized finding",
        "applies_to": ["final-report"],
        "references": "synthesized-findings.findings[].claim"
      }
    ],
    "confidence_consistency": [
      {
        "rule": "verdict_confidence_variance",
        "description": "If multiple sources verify same claim, confidence should increase or stay consistent",
        "applies_to": ["adversarial-verdict", "synthesized-findings"]
      },
      {
        "rule": "source_credibility_correlation",
        "description": "Claims with high-credibility sources should have proportionally higher confidence",
        "applies_to": ["synthesized-findings", "final-report"]
      },
      {
        "rule": "contradiction_decreases_confidence",
        "description": "Presence of contradicting sources should lower final confidence score",
        "applies_to": ["final-report"]
      }
    ],
    "data_quality_requirements": [
      {
        "requirement": "minimum_sources_per_claim",
        "description": "Verified claims should cite at least one source",
        "minimum": 1,
        "applies_to": ["final-report.verified_claims"]
      },
      {
        "requirement": "claim_evidence_balance",
        "description": "Supporting and counter evidence should be both documented when available",
        "applies_to": ["synthesized-findings", "final-report"]
      },
      {
        "requirement": "source_metadata_completeness",
        "description": "Source entries should have title, URL, and source_type at minimum",
        "required_fields": ["title", "url", "source_type"],
        "applies_to": ["final-report.sources"]
      }
    ]
  },
  "version_compatibility": {
    "schema_versions": {
      "extracted-claims": "1.0.0",
      "adversarial-verdict": "1.0.0",
      "synthesized-findings": "1.0.0",
      "final-report": "1.0.0"
    },
    "minimum_compatible_versions": {
      "extracted-claims": "1.0.0",
      "adversarial-verdict": "1.0.0",
      "synthesized-findings": "1.0.0",
      "final-report": "1.0.0"
    }
  },
  "error_codes": {
    "SCHEMA_VALIDATION_FAILED": "JSON does not conform to schema",
    "CLAIM_ID_MISSING": "claim_id required in verdict",
    "INVALID_CONFIDENCE": "confidence must be 0.0-1.0",
    "INVALID_ID_FORMAT": "ID does not match required pattern",
    "DUPLICATE_CLAIM_ID": "claim_id appears multiple times",
    "MISSING_REQUIRED_FIELD": "Required field is missing",
    "INVALID_ENUM_VALUE": "Value not in allowed enumeration",
    "URL_FORMAT_INVALID": "Invalid URL format",
    "DATE_FORMAT_INVALID": "Invalid date format (requires ISO 8601)",
    "TEXT_LENGTH_INVALID": "Text length outside allowed bounds",
    "REFERENTIAL_INTEGRITY_VIOLATION": "Referenced claim/finding/source does not exist",
    "CROSS_SCHEMA_CONSTRAINT_VIOLATION": "Data violates constraints across schemas"
  }
}
