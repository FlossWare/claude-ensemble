{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Final Report Schema",
  "description": "Schema for the final comprehensive research report from ai-pdf-deep-research workflow",
  "type": "object",
  "required": ["topic", "verified_claims", "metadata"],
  "properties": {
    "topic": {
      "type": "string",
      "description": "The research topic or subject matter",
      "minLength": 5,
      "maxLength": 300
    },
    "executive_summary": {
      "type": "string",
      "description": "High-level summary of findings and conclusions",
      "minLength": 50,
      "maxLength": 2000
    },
    "verified_claims": {
      "type": "array",
      "description": "Array of verified and synthesized claims",
      "items": {
        "type": "object",
        "required": ["id", "claim", "confidence"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for this verified claim in the report",
            "pattern": "^verified_[0-9]{3,}$"
          },
          "claim": {
            "type": "string",
            "description": "The verified claim statement",
            "minLength": 10,
            "maxLength": 1000
          },
          "confidence": {
            "type": "number",
            "description": "Overall confidence level (0.0-1.0)",
            "minimum": 0,
            "maximum": 1
          },
          "verification_grade": {
            "type": "string",
            "description": "Quality grade of verification",
            "enum": ["A", "B", "C", "D", "F"]
          },
          "supporting_evidence": {
            "type": "string",
            "description": "Summary of evidence supporting this claim",
            "minLength": 20,
            "maxLength": 800
          },
          "counter_evidence": {
            "type": "string",
            "description": "Any contradicting evidence or perspectives",
            "minLength": 0,
            "maxLength": 500
          },
          "sources_count": {
            "type": "integer",
            "description": "Number of sources supporting this claim",
            "minimum": 0
          },
          "source_diversity": {
            "type": "string",
            "description": "How diverse the sources are",
            "enum": ["single_source", "limited", "moderate", "high"]
          },
          "category": {
            "type": "string",
            "description": "Subject category",
            "enum": [
              "statistical",
              "historical",
              "scientific",
              "legal",
              "biographical",
              "technical",
              "economic",
              "medical",
              "other"
            ]
          },
          "importance": {
            "type": "string",
            "description": "Importance to the overall research topic",
            "enum": ["critical", "high", "medium", "low"]
          },
          "caveats": {
            "type": "array",
            "description": "Important caveats or limitations",
            "items": {
              "type": "string",
              "minLength": 10,
              "maxLength": 300
            },
            "maxItems": 5
          }
        },
        "additionalProperties": false
      },
      "minItems": 0
    },
    "sources": {
      "type": "array",
      "description": "Comprehensive source bibliography",
      "items": {
        "type": "object",
        "required": ["id", "title", "url"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique source identifier",
            "pattern": "^src_[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "description": "Source title",
            "minLength": 5,
            "maxLength": 400
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Source URL"
          },
          "authors": {
            "type": "array",
            "description": "Author names",
            "items": {
              "type": "string"
            }
          },
          "publication_date": {
            "type": "string",
            "format": "date",
            "description": "Date of publication"
          },
          "publisher": {
            "type": "string",
            "description": "Publisher or organization"
          },
          "source_type": {
            "type": "string",
            "description": "Type of source",
            "enum": [
              "academic_paper",
              "news_article",
              "government_report",
              "official_statement",
              "fact_check_website",
              "research_database",
              "book",
              "website",
              "pdf_document",
              "dataset"
            ]
          },
          "credibility_score": {
            "type": "number",
            "description": "Assessed credibility (0.0-1.0)",
            "minimum": 0,
            "maximum": 1
          },
          "domain_authority": {
            "type": "string",
            "description": "Authority level of the domain/publisher",
            "enum": ["expert", "high", "medium", "low", "unknown"]
          },
          "claims_supported": {
            "type": "array",
            "description": "IDs of verified claims this source supports",
            "items": {
              "type": "string",
              "pattern": "^verified_[0-9]{3,}$"
            }
          },
          "access_date": {
            "type": "string",
            "format": "date",
            "description": "Date source was accessed"
          },
          "archived_url": {
            "type": "string",
            "format": "uri",
            "description": "Archive URL (e.g., Wayback Machine)"
          }
        },
        "additionalProperties": false
      },
      "minItems": 0
    },
    "metadata": {
      "type": "object",
      "description": "Comprehensive metadata about the research and report",
      "required": ["research_date", "version"],
      "properties": {
        "report_id": {
          "type": "string",
          "description": "Unique report identifier",
          "pattern": "^report_[a-z0-9_-]{8,}$"
        },
        "research_date": {
          "type": "string",
          "format": "date",
          "description": "Date research was completed"
        },
        "version": {
          "type": "string",
          "description": "Report version",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "workflow_models": {
          "type": "array",
          "description": "AI models used in the workflow",
          "items": {
            "type": "string"
          }
        },
        "research_duration_minutes": {
          "type": "number",
          "description": "Total research duration in minutes",
          "minimum": 0
        },
        "documents_analyzed": {
          "type": "integer",
          "description": "Number of documents analyzed",
          "minimum": 1
        },
        "total_claims_extracted": {
          "type": "integer",
          "description": "Total claims extracted from sources",
          "minimum": 0
        },
        "claims_verified": {
          "type": "integer",
          "description": "Number of claims verified for the report",
          "minimum": 0
        },
        "total_sources_referenced": {
          "type": "integer",
          "description": "Total unique sources in bibliography",
          "minimum": 0
        },
        "quality_metrics": {
          "type": "object",
          "description": "Quality assessment metrics",
          "properties": {
            "source_diversity_score": {
              "type": "number",
              "description": "Diversity of sources (0.0-1.0)",
              "minimum": 0,
              "maximum": 1
            },
            "verification_coverage": {
              "type": "number",
              "description": "Percentage of claims with multiple sources",
              "minimum": 0,
              "maximum": 1
            },
            "average_claim_confidence": {
              "type": "number",
              "description": "Average confidence across all verified claims",
              "minimum": 0,
              "maximum": 1
            },
            "contradiction_rate": {
              "type": "number",
              "description": "Percentage of claims with contradicting sources",
              "minimum": 0,
              "maximum": 1
            },
            "overall_report_confidence": {
              "type": "number",
              "description": "Overall confidence in the entire report",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "limitations": {
          "type": "array",
          "description": "Limitations and constraints of the research",
          "items": {
            "type": "string",
            "minLength": 20,
            "maxLength": 500
          }
        },
        "methodology": {
          "type": "string",
          "description": "Description of research methodology",
          "minLength": 50,
          "maxLength": 1500
        },
        "next_steps": {
          "type": "array",
          "description": "Recommended areas for further research",
          "items": {
            "type": "string",
            "minLength": 20,
            "maxLength": 300
          }
        }
      }
    },
    "unverified_claims": {
      "type": "array",
      "description": "Claims that could not be verified due to lack of accessible sources",
      "items": {
        "type": "object",
        "required": ["claim", "reason"],
        "properties": {
          "claim": {
            "type": "string",
            "description": "The unverified claim",
            "minLength": 10,
            "maxLength": 1000
          },
          "reason": {
            "type": "string",
            "description": "Why it could not be verified",
            "enum": [
              "no_sources_found",
              "sources_unavailable",
              "requires_expert_knowledge",
              "opinion_based",
              "future_prediction",
              "insufficient_evidence"
            ]
          },
          "suggested_verification_path": {
            "type": "string",
            "description": "How it might be verified in the future",
            "maxLength": 300
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
