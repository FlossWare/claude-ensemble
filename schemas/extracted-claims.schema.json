{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Extracted Claims Schema",
  "description": "Schema for claims extracted from PDF documents during initial analysis phase",
  "type": "object",
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "description": "Array of factual claims extracted from the document",
      "items": {
        "type": "object",
        "required": ["id", "claim", "page", "confidence", "category", "falsifiable"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the claim (e.g., claim_001)",
            "pattern": "^claim_[0-9]{3,}$"
          },
          "claim": {
            "type": "string",
            "description": "The factual claim text",
            "minLength": 10,
            "maxLength": 500
          },
          "page": {
            "type": "integer",
            "description": "Page number where the claim appears",
            "minimum": 1
          },
          "context": {
            "type": "string",
            "description": "Surrounding context from the document",
            "minLength": 20,
            "maxLength": 1000
          },
          "confidence": {
            "type": "number",
            "description": "Confidence level that this is a factual claim (0.0-1.0)",
            "minimum": 0,
            "maximum": 1
          },
          "category": {
            "type": "string",
            "description": "Category of the claim",
            "enum": [
              "statistical",
              "historical",
              "scientific",
              "legal",
              "biographical",
              "technical",
              "economic",
              "medical",
              "other"
            ]
          },
          "falsifiable": {
            "type": "boolean",
            "description": "Whether the claim can be verified or refuted through evidence"
          },
          "extraction_method": {
            "type": "string",
            "description": "Method used to extract the claim",
            "enum": ["direct_quote", "paraphrased", "inferred"]
          },
          "source_type": {
            "type": "string",
            "description": "Type of source material in document",
            "enum": ["primary_source", "secondary_source", "data", "quote", "assumption"]
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "metadata": {
      "type": "object",
      "description": "Metadata about the extraction process",
      "properties": {
        "document_title": {
          "type": "string",
          "description": "Title of the PDF document"
        },
        "document_pages": {
          "type": "integer",
          "description": "Total number of pages in the document",
          "minimum": 1
        },
        "extraction_timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When extraction occurred"
        },
        "extractor_model": {
          "type": "string",
          "description": "AI model used for extraction"
        },
        "total_claims_extracted": {
          "type": "integer",
          "description": "Total number of claims extracted",
          "minimum": 0
        }
      }
    }
  },
  "additionalProperties": false
}
