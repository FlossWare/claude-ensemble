{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Adversarial Verdict Schema",
  "description": "Schema for verdicts on claims from adversarial verification process",
  "type": "object",
  "required": ["verdicts"],
  "properties": {
    "verdicts": {
      "type": "array",
      "description": "Array of verdicts from adversarial verification",
      "items": {
        "type": "object",
        "required": ["claim_id", "verdict", "confidence"],
        "properties": {
          "claim_id": {
            "type": "string",
            "description": "Reference to the claim being verified",
            "pattern": "^claim_[0-9]{3,}$"
          },
          "verdict": {
            "type": "string",
            "description": "Verification verdict for the claim",
            "enum": [
              "verified",
              "refuted",
              "partially_verified",
              "unverifiable",
              "requires_context"
            ]
          },
          "refuted": {
            "type": "boolean",
            "description": "Whether the claim was definitively refuted",
            "default": false
          },
          "reason": {
            "type": "string",
            "description": "Explanation of the verdict",
            "minLength": 20,
            "maxLength": 1000
          },
          "confidence": {
            "type": "number",
            "description": "Confidence level in this verdict (0.0-1.0)",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "description": "Evidence supporting or refuting the claim",
            "items": {
              "type": "object",
              "required": ["source", "type"],
              "properties": {
                "source": {
                  "type": "string",
                  "description": "Source of the evidence",
                  "minLength": 10
                },
                "type": {
                  "type": "string",
                  "description": "Type of evidence",
                  "enum": [
                    "academic",
                    "news",
                    "government",
                    "official_statement",
                    "data",
                    "expert_opinion",
                    "fact_check",
                    "counter_evidence"
                  ]
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "URL to the evidence source"
                },
                "quote": {
                  "type": "string",
                  "description": "Relevant quote from the evidence",
                  "maxLength": 500
                },
                "relevance_score": {
                  "type": "number",
                  "description": "How relevant this evidence is (0.0-1.0)",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "additionalProperties": false
            },
            "minItems": 0
          },
          "alternative_interpretations": {
            "type": "array",
            "description": "Alternative ways to interpret the claim",
            "items": {
              "type": "string",
              "minLength": 20,
              "maxLength": 500
            },
            "maxItems": 5
          },
          "verification_model": {
            "type": "string",
            "description": "AI model used for verification"
          },
          "verification_timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "When verification occurred"
          },
          "requires_expert_review": {
            "type": "boolean",
            "description": "Whether this claim needs expert human review",
            "default": false
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "summary": {
      "type": "object",
      "description": "Summary statistics of verification results",
      "properties": {
        "total_verified": {
          "type": "integer",
          "description": "Number of verified claims",
          "minimum": 0
        },
        "total_refuted": {
          "type": "integer",
          "description": "Number of refuted claims",
          "minimum": 0
        },
        "total_partially_verified": {
          "type": "integer",
          "description": "Number of partially verified claims",
          "minimum": 0
        },
        "total_unverifiable": {
          "type": "integer",
          "description": "Number of unverifiable claims",
          "minimum": 0
        },
        "verification_coverage": {
          "type": "number",
          "description": "Percentage of claims verified (0.0-1.0)",
          "minimum": 0,
          "maximum": 1
        },
        "average_confidence": {
          "type": "number",
          "description": "Average confidence across all verdicts",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "additionalProperties": false
}
