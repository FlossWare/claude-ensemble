{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://claude-global-skills/schemas/model-inventory.schema.json",
  "title": "NAS Model Inventory",
  "description": "Schema for NAS model inventory tracking",
  "type": "object",
  "required": ["_version", "_last_updated", "nas_path", "models"],
  "properties": {
    "_comment": {
      "type": "string",
      "description": "Human-readable comment about this file"
    },
    "_version": {
      "type": "string",
      "description": "Schema version",
      "pattern": "^\\d+\\.\\d+$"
    },
    "_last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last update"
    },
    "nas_path": {
      "type": "string",
      "description": "Base path where models are stored on NAS"
    },
    "models": {
      "type": "object",
      "description": "Map of model name to model metadata",
      "patternProperties": {
        "^[a-zA-Z0-9._:-]+$": {
          "type": "object",
          "required": ["vendor", "format", "downloaded", "version", "distributed_to", "nas_path"],
          "properties": {
            "vendor": {
              "type": "string",
              "enum": ["ollama", "huggingface", "gguf-direct", "thebloke", "meta", "mistral", "google", "microsoft", "alibaba"],
              "description": "Vendor/source of the model"
            },
            "format": {
              "type": "string",
              "enum": ["ollama-native", "gguf", "safetensors", "pytorch", "onnx", "tensorflow"],
              "description": "Model file format"
            },
            "size_gb": {
              "type": "number",
              "description": "Model size in gigabytes",
              "minimum": 0
            },
            "disk_usage": {
              "type": "string",
              "description": "Human-readable disk usage (e.g., '12G')",
              "pattern": "^\\d+(\\.\\d+)?[KMGT]?$"
            },
            "downloaded": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 timestamp when model was downloaded"
            },
            "version": {
              "type": "string",
              "description": "Model version (e.g., 'latest', 'v1.2.3')"
            },
            "checksum": {
              "type": "string",
              "description": "SHA256 checksum of model files",
              "pattern": "^sha256:[a-f0-9]{64}$|^N/A$"
            },
            "source_url": {
              "type": "string",
              "description": "Original source URL for download"
            },
            "needs_conversion": {
              "type": "boolean",
              "description": "Whether format conversion is needed for Ollama/llama.cpp",
              "default": false
            },
            "converted_to": {
              "type": "string",
              "enum": ["gguf", "ollama-native"],
              "description": "Format this model was converted to (if applicable)"
            },
            "conversion_path": {
              "type": "string",
              "description": "Path to converted version (if applicable)"
            },
            "distributed_to": {
              "type": "array",
              "description": "List of nodes that have received this model",
              "items": {
                "type": "string",
                "description": "Node hostname"
              },
              "uniqueItems": true
            },
            "nas_path": {
              "type": "string",
              "description": "Full path to model on NAS"
            },
            "last_distributed": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 timestamp of last distribution"
            },
            "quantization": {
              "type": "string",
              "description": "Quantization level (e.g., Q4_K_M, Q5_K_M, fp16)"
            },
            "license": {
              "type": "string",
              "description": "Model license (e.g., MIT, Apache-2.0, Meta)"
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "_comment": "NAS Model Inventory - Central repository of downloaded models",
      "_version": "1.0",
      "_last_updated": "2026-06-13T17:00:00Z",
      "nas_path": "/mnt/nas/ai-models",
      "models": {
        "codestral:22b": {
          "size_gb": 12.0,
          "disk_usage": "12G",
          "downloaded": "2026-06-13T17:00:00Z",
          "version": "latest",
          "checksum": "sha256:abc123def456789abc123def456789abc123def456789abc123def456789abc1",
          "distributed_to": ["server-02"],
          "nas_path": "/mnt/nas/ai-models/ollama/codestral:22b",
          "last_distributed": "2026-06-13T17:30:00Z"
        },
        "qwen2.5-coder:7b": {
          "size_gb": 4.7,
          "disk_usage": "4.7G",
          "downloaded": "2026-06-13T17:05:00Z",
          "version": "latest",
          "checksum": "sha256:def456abc789def456abc789def456abc789def456abc789def456abc789def4",
          "distributed_to": ["localhost"],
          "nas_path": "/mnt/nas/ai-models/ollama/qwen2.5-coder:7b",
          "last_distributed": "2026-06-13T17:35:00Z"
        }
      }
    }
  ]
}
