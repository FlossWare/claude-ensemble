{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://claude-global-skills/schemas/distribution-log.schema.json",
  "title": "Distribution Log",
  "description": "Schema for model distribution tracking log",
  "type": "object",
  "required": ["distributions"],
  "properties": {
    "_comment": {
      "type": "string",
      "description": "Human-readable comment about this file"
    },
    "distributions": {
      "type": "array",
      "description": "Chronological log of model distributions",
      "items": {
        "type": "object",
        "required": ["model", "node", "timestamp", "status"],
        "properties": {
          "model": {
            "type": "string",
            "description": "Model name (e.g., 'codestral:22b')"
          },
          "node": {
            "type": "string",
            "description": "Target node hostname"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of distribution"
          },
          "status": {
            "type": "string",
            "enum": ["success", "failed", "pending"],
            "description": "Distribution status"
          },
          "error": {
            "type": "string",
            "description": "Error message if status is 'failed'"
          },
          "bytes_transferred": {
            "type": "number",
            "description": "Number of bytes transferred",
            "minimum": 0
          },
          "duration_seconds": {
            "type": "number",
            "description": "Distribution duration in seconds",
            "minimum": 0
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "_comment": "Distribution log - Track model deployment to nodes",
      "distributions": [
        {
          "model": "codestral:22b",
          "node": "server-02",
          "timestamp": "2026-06-13T17:30:00Z",
          "status": "success",
          "bytes_transferred": 12884901888,
          "duration_seconds": 96.5
        },
        {
          "model": "qwen2.5-coder:7b",
          "node": "localhost",
          "timestamp": "2026-06-13T17:35:00Z",
          "status": "success",
          "bytes_transferred": 5046586573,
          "duration_seconds": 38.2
        },
        {
          "model": "deepseek-r1:32b",
          "node": "server-02",
          "timestamp": "2026-06-13T17:40:00Z",
          "status": "failed",
          "error": "Node unreachable: connection timeout"
        }
      ]
    }
  ]
}
