[Unit]
Description=Disseminator Autonomous Learning System
After=network.target
Documentation=file:///home/sfloess/.claude/learning/DISSEMINATOR_LEARNER_README.md

[Service]
Type=simple
User=sfloess
WorkingDirectory=/home/sfloess/.claude/learning
ExecStart=/usr/bin/node /home/sfloess/.claude/learning/disseminator-learner.js --continuous
Restart=on-failure
RestartSec=300
StandardOutput=append:/home/sfloess/.claude/learning/logs/disseminator-learner.log
StandardError=append:/home/sfloess/.claude/learning/logs/disseminator-learner.error.log

# Environment
Environment="NODE_ENV=production"
Environment="HOME=/home/sfloess"

# Resource limits
MemoryMax=2G
CPUQuota=50%

# Cost control - enforce daily budget
Environment="DAILY_COST_LIMIT=50.00"

[Install]
WantedBy=multi-user.target
