[Unit]
Description=Run Perpetual AI Expert every 6 hours
Documentation=file:///home/sfloess/.claude/learning/PERPETUAL_AI_EXPERT.md

[Timer]
# Run every 6 hours (stagger from web-learner)
OnBootSec=10min
OnUnitActiveSec=6h

# Add jitter to avoid slamming APIs
RandomizedDelaySec=15min

# Run missed instances if system was off
Persistent=true

[Install]
WantedBy=timers.target
