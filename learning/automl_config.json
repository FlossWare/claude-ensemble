      "code": "predictions = automl.predict(X_new)",
      "description": "Make predictions on new data"
    },
    "probabilities": {
      "code": "probabilities = automl.predict_proba(X_new)",
      "description": "Get prediction probabilities (classification only)"
    },
    "feature_importance": {
      "code": "importance = automl.get_feature_importance(top_n=10)",
      "description": "Get top N feature importances (if available)"
    },
    "save_load": {
      "save": "automl.save('/path/to/model.pkl')",
      "load": "automl = AutoMLSystem.load('/path/to/model.pkl')"
