[Unit]
Description=RH Memory Service - Central memory authority for Claude Code sessions
Documentation=file://%h/.config/systemd/user/rh-memory.service.d/README.md
After=network.target

[Service]
Type=simple
ExecStart=%REPO_PATH%/memory-service/memory_service.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rh-memory-service

# User running the service (no need to set, runs as current user with systemd --user)
# User=%u

# Environment
Environment="PATH=%h/.local/bin:%REPO_PATH%/tools:/usr/local/bin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"

# Resource limits
MemoryLimit=512M
CPUQuota=50%

[Install]
WantedBy=default.target
