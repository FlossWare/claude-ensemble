{
  "name": "code-review-and-solve",
  "description": "Complete quality loop - review finds ALL issues, solve fixes ALL of them (AUTONOMOUS)",
  "entrypoint": "../workflows/code-review-and-solve.js",
  "completions": {
    "arguments": [],
    "options": [
      {
        "name": "--days",
        "type": "number",
        "default": 30,
        "description": "Review last N days of commits"
      },
      {
        "name": "--maxCommits",
        "type": "number",
        "default": 5,
        "description": "Max commits to review"
      },
      {
        "name": "--maxFiles",
        "type": "number",
        "default": 10,
        "description": "Max files to review"
      }
    ]
  }
}
