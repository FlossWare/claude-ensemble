{
  "dashboard": {
    "id": null,
    "uid": "multi-ai-metrics",
    "title": "Multi-AI Orchestration Metrics",
    "tags": ["ai", "orchestration", "models"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "type": "graph",
        "title": "Model Request Rate",
        "targets": [
          {
            "expr": "rate(ai_model_requests_total[5m])",
            "legendFormat": "{{model}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "label": "Requests/sec",
            "format": "short"
          }
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "legend": {"show": true, "values": true, "current": true}
      },
      {
        "id": 2,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "type": "graph",
        "title": "Model Response Time",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(ai_model_duration_seconds_bucket[5m]))",
            "legendFormat": "{{model}} P95",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "label": "Response Time",
            "format": "s"
          }
        ],
        "lines": true,
        "fill": 0,
        "linewidth": 2
      },
      {
        "id": 3,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "type": "graph",
        "title": "Token Usage",
        "targets": [
          {
            "expr": "rate(ai_tokens_consumed_total{type=\"input\"}[5m])",
            "legendFormat": "{{model}} Input",
            "refId": "A"
          },
          {
            "expr": "rate(ai_tokens_consumed_total{type=\"output\"}[5m])",
            "legendFormat": "{{model}} Output",
            "refId": "B"
          }
        ],
        "yaxes": [
          {
            "label": "Tokens/sec",
            "format": "short"
          }
        ],
        "lines": true,
        "fill": 0,
        "linewidth": 2
      },
      {
        "id": 4,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "type": "graph",
        "title": "API Cost Rate",
        "targets": [
          {
            "expr": "rate(ai_api_cost_usd_total[1h])",
            "legendFormat": "{{model}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "label": "Cost $/hour",
            "format": "currencyUSD"
          }
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2
      },
      {
        "id": 5,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "type": "graph",
        "title": "Model Success Rate",
        "targets": [
          {
            "expr": "100 * (rate(ai_model_requests_total{status=\"success\"}[5m]) / rate(ai_model_requests_total[5m]))",
            "legendFormat": "{{model}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "label": "Success %",
            "format": "percent",
            "min": 0,
            "max": 100
          }
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2
      },
      {
        "id": 6,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "type": "graph",
        "title": "Fleet Utilization",
        "targets": [
          {
            "expr": "100 * (fleet_workers_busy / fleet_workers_total)",
            "legendFormat": "Worker Utilization %",
            "refId": "A"
          }
        ],
        "yaxes": [
          {
            "label": "Utilization %",
            "format": "percent",
            "min": 0,
            "max": 100
          }
        ],
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "thresholds": [
          {"value": 80, "op": "gt", "fill": true, "line": true, "colorMode": "custom"}
        ]
      },
      {
        "id": 7,
        "gridPos": {"h": 6, "w": 6, "x": 0, "y": 24},
        "type": "stat",
        "title": "Total Models Active",
        "targets": [
          {
            "expr": "count(count by (model) (ai_model_requests_total))",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "none",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 10, "color": "yellow"},
                {"value": 35, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 8,
        "gridPos": {"h": 6, "w": 6, "x": 6, "y": 24},
        "type": "stat",
        "title": "Total Requests (24h)",
        "targets": [
          {
            "expr": "sum(increase(ai_model_requests_total[24h]))",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0
          }
        }
      },
      {
        "id": 9,
        "gridPos": {"h": 6, "w": 6, "x": 12, "y": 24},
        "type": "stat",
        "title": "Total Cost (24h)",
        "targets": [
          {
            "expr": "sum(increase(ai_api_cost_usd_total[24h]))",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 10, "color": "yellow"},
                {"value": 50, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 10,
        "gridPos": {"h": 6, "w": 6, "x": 18, "y": 24},
        "type": "stat",
        "title": "Average Quality Score",
        "targets": [
          {
            "expr": "avg(ai_model_quality_score)",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 3,
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "red"},
                {"value": 0.7, "color": "yellow"},
                {"value": 0.85, "color": "green"}
              ]
            }
          }
        }
      }
    ],
    "time": {"from": "now-6h", "to": "now"},
    "timepicker": {
      "refresh_intervals": ["30s", "1m", "5m", "15m", "30m"],
      "time_options": ["1h", "6h", "12h", "24h", "2d", "7d", "30d"]
    },
    "templating": {"list": []},
    "annotations": {"list": []},
    "editable": true,
    "gnetId": null,
    "graphTooltip": 1,
    "links": []
  },
  "overwrite": true
}
