        "y": 4
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT d.category, count(DISTINCT d.id) as docs, count(c.id) as chunks, count(e.chunk_id) as embeddings FROM knowledge.documents d LEFT JOIN knowledge.chunks c ON c.document_id = d.id LEFT JOIN knowledge.embeddings e ON e.chunk_id = c.id GROUP BY d.category ORDER BY docs DESC",
          "refId": "A"
        }
      ],
      "title": "Category Details",
      "type": "table"
