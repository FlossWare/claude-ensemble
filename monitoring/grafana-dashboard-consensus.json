{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [
        {
          "expr": "rate(consensus_decisions_total[1m])",
          "legendFormat": "Decisions/min"
        }
      ],
      "title": "Consensus Decisions Per Minute",
      "type": "timeseries"
    },
    {
      "datasource": "PostgreSQL",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "Quality Score",
            "drawStyle": "line",
            "lineWidth": 2
          },
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT date_trunc('hour', wr.created_at) as time, wr.model, AVG(wr.quality_score) as quality FROM workflow.worker_results wr WHERE wr.created_at >= NOW() - INTERVAL '7 days' AND wr.quality_score IS NOT NULL GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "title": "Model Performance Trends (7-day avg quality)",
      "type": "timeseries"
    },
    {
      "datasource": "PostgreSQL",
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "left"}
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT model, drift_type, drift_magnitude, detected_at, CASE WHEN acknowledged_at IS NULL THEN 'Pending' ELSE 'Acknowledged' END as status FROM monitoring.model_drift WHERE detected_at >= NOW() - INTERVAL '24 hours' ORDER BY drift_magnitude DESC LIMIT 10"
        }
      ],
      "title": "Drift Alerts (Recent 24h)",
      "type": "table"
    },
    {
      "datasource": "PostgreSQL",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"}
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "options": {
        "pieType": "pie",
        "displayLabels": ["percent"]
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT CASE WHEN disagreement_score < 0.1 THEN '< 0.1 (Strong consensus)' WHEN disagreement_score < 0.2 THEN '0.1-0.2 (Moderate consensus)' WHEN disagreement_score < 0.3 THEN '0.2-0.3 (Weak consensus)' ELSE '>= 0.3 (Divergent)' END as range, COUNT(*) as count FROM workflow.arbiter_decisions WHERE created_at >= NOW() - INTERVAL '7 days' GROUP BY range ORDER BY range"
        }
      ],
      "title": "Disagreement Score Distribution (7 days)",
      "type": "piechart"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "Cost (USD)",
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {"mode": "normal"}
          },
          "unit": "currencyUSD"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 5,
      "targets": [
        {
          "expr": "sum by(model) (increase(consensus_cost_usd[1h]))",
          "legendFormat": "{{model}}"
        }
      ],
      "title": "Cost Per Decision (Stacked by Model, 1h intervals)",
      "type": "timeseries"
    },
    {
      "datasource": "PostgreSQL",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "unit": "percentunit"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 6,
      "options": {
        "pieType": "donut",
        "displayLabels": ["name", "percent"]
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "WITH strategy_successes AS (SELECT strategy, SUM(CASE WHEN success THEN 1 ELSE 0 END)::float / NULLIF(COUNT(*), 0) as success_rate FROM learning.experiences WHERE created_at >= NOW() - INTERVAL '7 days' GROUP BY strategy) SELECT strategy as metric, success_rate as value FROM strategy_successes ORDER BY success_rate DESC LIMIT 10"
        }
      ],
      "title": "Thompson Sampling Weights (Success Rate by Strategy)",
      "type": "piechart"
    },
    {
      "datasource": "PostgreSQL",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 10},
              {"color": "red", "value": 50}
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "id": 7,
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT COUNT(*) as value FROM workflow.human_review_queue WHERE reviewed_at IS NULL"
        }
      ],
      "title": "Human Review Queue Depth",
      "type": "stat"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 27,
  "style": "dark",
  "tags": ["consensus", "monitoring", "ai"],
  "time": {"from": "now-24h", "to": "now"},
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "30m", "1h"]
  },
  "timezone": "browser",
  "title": "Consensus Monitoring Dashboard",
  "uid": "consensus-monitoring",
  "version": 1
}
