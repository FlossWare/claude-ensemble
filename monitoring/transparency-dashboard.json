{
  "dashboard": {
    "title": "Fleet Transparency Dashboard",
    "tags": ["fleet", "transparency", "autonomous"],
    "timezone": "browser",
    "refresh": "30s",
    "schemaVersion": 38,
    "version": 1
  },
  "panels": [
    {
      "id": 1,
      "title": "Real-time Fleet Status",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "expr": "fleet_bugs_pending",
          "legendFormat": "Bugs Pending"
        },
        {
          "expr": "fleet_validations_failed",
          "legendFormat": "Validations Failed"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "orientation": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Bug Discovery & Fix Rate",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(fleet_bugs_found_total[5m])",
          "legendFormat": "Bugs Found (per 5m)"
        },
        {
          "expr": "rate(fleet_bugs_fixed_total[5m])",
          "legendFormat": "Bugs Fixed (per 5m)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Validation Success Rate",
      "type": "gauge",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "expr": "fleet_validations_passed / (fleet_validations_passed + fleet_validations_failed) * 100",
          "legendFormat": "Success Rate %"
        }
      ],
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "value": 0, "color": "red" },
              { "value": 70, "color": "yellow" },
              { "value": 90, "color": "green" }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 4,
      "title": "Recent Events Timeline",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "{job=\"fleet-transparency\"}",
          "legendFormat": ""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true
      }
    },
    {
      "id": 5,
      "title": "Deployment Success/Failure",
      "type": "piechart",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "fleet_deployments_success",
          "legendFormat": "Success"
        },
        {
          "expr": "fleet_deployments_failed",
          "legendFormat": "Failed"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Learning Sessions",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "fleet_learning_sessions_total",
          "legendFormat": "Total Sessions"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 7,
      "title": "GitHub Issues Status",
      "type": "bargauge",
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "fleet_issues_open",
          "legendFormat": "Open"
        },
        {
          "expr": "fleet_issues_closed",
          "legendFormat": "Closed"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "id": 8,
      "title": "Bug Severity Breakdown",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "fleet_bugs_by_severity",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {
              "severity": "Severity",
              "Value": "Count"
            }
          }
        }
      ]
    },
    {
      "id": 9,
      "title": "Fix Attempt Success Rate",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(fleet_fix_success_total[10m])",
          "legendFormat": "Successful Fixes"
        },
        {
          "expr": "rate(fleet_fix_failed_total[10m])",
          "legendFormat": "Failed Fixes"
        }
      ]
    },
    {
      "id": 10,
      "title": "Alerts & Notifications",
      "type": "alertlist",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 6
      },
      "options": {
        "showOptions": "current",
        "maxItems": 20,
        "sortOrder": 1,
        "dashboardAlerts": true,
        "alertName": "",
        "dashboardTitle": "",
        "tags": []
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "severity",
        "type": "query",
        "label": "Severity Filter",
        "query": "label_values(fleet_bugs_by_severity, severity)",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "workflow",
        "type": "query",
        "label": "Workflow",
        "query": "label_values(fleet_events_total, workflow_id)",
        "multi": false,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Critical Events",
        "datasource": "Prometheus",
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{severity=\"critical\"}"
      },
      {
        "name": "Deployments",
        "datasource": "Prometheus",
        "enable": true,
        "iconColor": "blue",
        "expr": "changes(fleet_deployments_success[5m])"
      }
    ]
  }
}
