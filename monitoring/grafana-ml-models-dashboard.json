      "targets": [
        {
          "datasource": "PostgreSQL",
          "format": "time_series",
          "rawSql": "SELECT\n  date_trunc('hour', measurement_time) as time,\n  model_name,\n  AVG(COALESCE(mae, 0)) as mae,\n  AVG(COALESCE(r_squared, 0)) as r_squared,\n  AVG(COALESCE(rmse, 0)) as rmse\nFROM monitoring.prediction_accuracy\nWHERE measurement_time >= NOW() - INTERVAL '30 days'\nGROUP BY 1, 2\nORDER BY 1 DESC",
          "refId": "A"
        }
      ],
      "title": "Prediction Accuracy Over Time (MAE/R² by Model)",
      "type": "timeseries"
    },
